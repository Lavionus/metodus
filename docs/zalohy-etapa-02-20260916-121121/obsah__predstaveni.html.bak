  const plocha = $('plocha'), skoreEl = $('ulohaSkore');
  const zamichej = p => { const a = [...p]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
  let poradi = zamichej(UKAZKY), index = 0, spravne = 0, pokusy = 0, casovac = null;

  function dalsi() {
    clearTimeout(casovac);
    index++;
    if (index >= poradi.length) {
      const posledni = poradi[poradi.length - 1];
      do { poradi = zamichej(UKAZKY); } while (poradi[0] === posledni);
      index = 0;
    }
    vykresli(poradi[index]);
  }

  function vykresli(u) {
    clearTimeout(casovac);
    plocha.innerHTML = `<div class="zadani">${u.predmet} — ${u.zadani}</div>`
      + `<div class="veta-uloha">${u.veta}</div><div class="odezva"></div>`;
    const odezva = plocha.querySelector('.odezva');
    const moznosti = document.createElement('div');
    moznosti.className = 'moznosti';
    let chyboval = false, hotovo = false;

    zamichej(u.moznosti).forEach(popis => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = popis;
      b.addEventListener('click', () => {
        if (hotovo) return;
        if (popis !== u.spravna) {
          // chyba úlohu nezavírá – jen zaklepe a otázka běží dál
          chyboval = true;
          b.classList.remove('trhni');
          void b.offsetWidth;
          b.classList.add('trhni', 'spatne');
          setTimeout(() => b.classList.remove('spatne', 'trhni'), 420);
          odezva.className = 'odezva chyba';
          odezva.textContent = 'Ještě ne – zkus to znovu.';
          return;
        }
        hotovo = true;
        b.classList.add('spravne');
        odezva.className = 'odezva ok';
        odezva.textContent = '✅ Správně!';
        pokusy++;
        if (!chyboval) spravne++;
        skoreEl.textContent = `Správně napoprvé: ${spravne} z ${pokusy}`;

        const mezera = plocha.querySelector('.mezera');
        if (u.doplni && mezera) { mezera.textContent = u.doplni; mezera.classList.add('doplneno'); }

        const p = document.createElement('div');
        p.className = 'pravidlo';
        p.innerHTML = '<span class="znak">💡</span><div>' + u.pravidlo + '</div>';
        plocha.appendChild(p);
        // delší pauza kvůli kartičce s vysvětlením, po chybě ještě delší
        casovac = setTimeout(dalsi, chyboval ? 3800 : 2600);
      });
      moznosti.appendChild(b);
    });
    plocha.appendChild(moznosti);
  }

  $('btnDalsi').addEventListener('click', dalsi);
  vykresli(poradi[index]);
}
/* ============================================================
   7. GENERÁTOR TESTŮ
   Zkrácená verze obsah/pracovni_listy.html: patnáct generátorů místo
   celého katalogu, bez záhlaví školy a bez ukládání nastavení. Zůstává
   to podstatné – úlohy se počítají ze seedovaného generátoru náhody,
   takže **stejný kód listu vyrobí pokaždé stejný test** (a řešení k němu).
   Slovní zásoba i banky úloh jsou převzaté z plné verze.
   ============================================================ */
{
  function makeRng(seedStr){
    let h=2166136261>>>0;
    for(let i=0;i<seedStr.length;i++){h^=seedStr.charCodeAt(i);h=Math.imul(h,16777619)>>>0;}
    let s=h>>>0;
    const next=()=>{s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return ((t^t>>>14)>>>0)/4294967296;};
    const R={
      next,
      int:(a,b)=>a+Math.floor(next()*(b-a+1)),
      pick:a=>a[Math.floor(next()*a.length)],
      chance:p=>next()<p,
      shuffle(a){const o=a.slice();for(let i=o.length-1;i>0;i--){const j=Math.floor(next()*(i+1));[o[i],o[j]]=[o[j],o[i]];}return o;}
    };
    return R;
  }

  function tier(bank,d){
    if(d==='easy')return bank.easy;
    if(d==='hard')return bank.hard.concat(bank.medium);
    return bank.easy.concat(bank.medium);
  }
  const VYJM={easy:[
