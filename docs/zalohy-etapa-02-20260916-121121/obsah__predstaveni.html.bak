      "analogie": "Třídírna a balírna",
      "pozor": "Navazuje například na drsné ER při zpracování bílkovin určených k vyloučení.",
      "group": "vyroba"
    },
    "mitochondrie": {
      "n": "Mitochondrie",
      "d": "Při buněčném dýchání vytvářejí většinu ATP.",
