      <path class="organ" data-o="jadro" fill-rule="evenodd" d="M497,96 L536,97 L560,103 L558,110 L561,113 L566,107 L578,111 L602,129 L597,135 L601,140 L606,135 L610,136 L625,156 L629,166 L624,165 L621,171 L624,174 L632,172 L635,179 L639,233 L623,283 L609,301 L607,286 L626,266 L628,255 L624,251 L613,254 L611,258 L618,265 L609,271 L602,268 L598,274 L603,279 L587,291 L571,281 L563,289 L566,292 L574,290 L575,297 L533,309 L520,309 L517,300 L511,309 L502,309 L499,305 L496,308 L483,306 L478,303 L483,298 L480,293 L475,298 L477,301 L472,303 L449,294 L452,287 L449,282 L433,297 L424,281 L411,278 L397,264 L387,232 L388,205 L392,197 L388,186 L404,152 L425,128 L444,114 L459,110 L467,103 L497,96 Z"/>
      <circle class="organ" data-o="jaderko" cx="520" cy="202" r="44"/>
      <circle class="organ" data-o="vezikula" cx="322" cy="125" r="25"/>
      <circle class="organ" data-o="vezikula" cx="690" cy="579" r="24"/>
