    },
    "er": {
      "n": "Endoplazmatické retikulum",
      "d": "Podílí se na tvorbě a zpracování bílkovin a lipidů.",
      "stavba": "Síť membránových kanálků a váčků. Drsné ER nese ribozomy, hladké ER je nemá a tvoří například lipidy.",
      "analogie": "Výrobní a dopravní síť",
      "pozor": "Bílkoviny sestavují ribozomy; drsné ER pomáhá s jejich zpracováním a přepravou.",
