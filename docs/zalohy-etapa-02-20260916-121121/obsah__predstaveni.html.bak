<!DOCTYPE html>
<!-- Světlý motiv je tu výchozí (na rozdíl od zbytku Metodusu): stránka se
     promítá a ukazuje, a na plátně i v tištěném archu vypadá líp na světlém.
     Atribut je rovnou v HTML, aby při načtení neproblesklo tmavé pozadí. -->
<html lang="cs" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Metodus – živé ukázky</title>
  <meta name="description" content="Ukázková stránka Metodusu: interaktivní periodická tabulka, gravitační hřiště, aerodynamický tunel, stavba buňky, graf funkce a procvičování – vše živé přímo na stránce.">
  <link rel="icon" href="../favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="../favicon.ico" sizes="16x16 32x32 48x48">
  <!-- Sdílené skripty Metodusu jsou tu jen jako doplněk: podpis.js přidá autorský
       pruh, apps.js dodá čísla katalogu. Stránka je schválně SOBĚSTAČNÁ – když
       se vytrhne ze složky a oba chybí, funguje dál (má vlastní paletu, vlastní
       přepínač motivu a části závislé na katalogu se samy skryjí).

       `theme.js` tu schválně NENÍ: srovnával by motiv se zbytkem Metodusu, a tahle
       stránka má mít vlastní výchozí (světlý) motiv i vlastní paměť volby. -->
  <script src="../podpis.js" defer></script>
  <script>
    /* Volba motivu jen pro tuhle stránku – čte se ještě před vykreslením,
       aby při přepnutí do tmavého nezablikalo světlé pozadí. */
    try {
      if (localStorage.getItem('metodus_ukazky_tema') === 'dark') {
        delete document.documentElement.dataset.theme;
      }
    } catch { /* soukromé okno – zůstane výchozí světlý motiv */ }
  </script>
  <style>
    /* ============================================================
       Metodus – stránka živých ukázek.

       Barvy jsou schválně KOPIE proměnných z common.css, ne odkaz na něj:
       tahle stránka se má dát poslat jako jediný soubor (učiteli mailem,
       na projektor, do cizího webu) a musí vypadat stejně i bez zbytku
       Metodusu. Cena je jedno místo navíc při změně palety.
       ============================================================ */
    :root {
      --bg: #1a1a1a; --bg-deep: #121212; --bg-panel: #242424; --bg-elevated: #2d2d2d;
      --bg-control: #383838; --bg-input: #1e1e1e; --bg-hover: #333333;
      --text: #e0e0e0; --text-muted: #b0b0b0; --text-faint: #888888;
      --border: #404040; --border-strong: #4a4a4a;
      --accent: #6aa6fd; --accent-soft: rgba(106, 166, 253, 0.15); --accent-hover: #8bbcff;
      --ok: #4caf7d; --warn: #e0a63f; --danger: #e05d5d;
      --ok-text: var(--ok); --danger-text: var(--danger); --zvyraz-text: var(--warn);
      --radius: 8px; --shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
      --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color-scheme: dark;
    }
    :root[data-theme="light"] {
      --bg: #f2f3f5; --bg-deep: #e8eaed; --bg-panel: #ffffff; --bg-elevated: #ffffff;
      --bg-control: #e9ecef; --bg-input: #ffffff; --bg-hover: #e2e6ea;
      --text: #24292f; --text-muted: #4b535b; --text-faint: #7a828a;
      --border: #d0d7de; --border-strong: #b9c2cb;
      --accent: #2f6fce; --accent-soft: rgba(47, 111, 206, 0.12); --accent-hover: #1f5bb5;
      --shadow: 0 2px 10px rgba(0, 0, 0, 0.12);
      /* stavové barvy pro TEXT na bílém papíře – tmavší, jinak nejsou vidět */
      --ok-text: #1f7a52; --danger-text: #b3261e; --zvyraz-text: #8a6209;
      color-scheme: light;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font); background: var(--bg-deep); color: var(--text); }
    .obal { max-width: 1060px; margin: 0 auto; padding: 0 clamp(14px, 3.5vw, 36px); }

    /* ---- Úvodní pruh ---- */
    .hero {
      background: radial-gradient(1200px 380px at 10% -40%, var(--accent-soft), transparent 70%), var(--bg-panel);
      border-bottom: 1px solid var(--border);
      padding: clamp(26px, 5vw, 52px) 0 clamp(22px, 4vw, 38px);
    }
    .hero h1 {
      font-size: clamp(1.9rem, 6vw, 3rem); font-weight: 700; letter-spacing: -0.01em;
      display: flex; align-items: center; gap: 0.28em; margin-bottom: 10px;
    }
    .hero h1 .symbol { width: 1.3em; height: 0.97em; fill: var(--accent); flex: none; }
    .hero .claim { font-size: clamp(1rem, 2.4vw, 1.25rem); line-height: 1.5; max-width: 660px; }
    .hero .claim b { color: var(--accent); font-weight: 650; }
    .hero .drobne { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; max-width: 660px; margin-top: 10px; }

    .cisla { display: flex; flex-wrap: wrap; gap: clamp(16px, 4vw, 40px); margin-top: 22px; }
    .cisla .hodnota { font-size: clamp(1.5rem, 4.5vw, 2rem); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
    .cisla .popisek { color: var(--text-faint); font-size: 0.8rem; }

    .tlacitka { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 22px; }
    .tlacitka a, .tlacitka button, .demo-lista button, .demo-lista a {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--bg-control); border: 1px solid var(--border-strong); color: var(--text);
      border-radius: 9px; padding: 10px 16px; font-size: 0.92rem; font-family: inherit;
      font-weight: 600; text-decoration: none; cursor: pointer;
      transition: transform 0.12s ease, border-color 0.12s ease, background-color 0.12s ease;
    }
    .tlacitka a:hover, .tlacitka button:hover, .demo-lista button:hover, .demo-lista a:hover {
      border-color: var(--accent); background: var(--bg-hover); transform: translateY(-2px);
    }
    .tlacitka .hlavni { background: var(--accent); border-color: var(--accent); color: #fff; }
    .tlacitka .hlavni:hover { background: var(--accent-hover); border-color: var(--accent-hover); }

    /* Značka Metodusu je uzel – síť teček a spojnic v hlavičce na to hraje.
       Je jen kulisa: leží pod obsahem, nechytá klikání a při
       prefers-reduced-motion se nakreslí jen jednou a zamrzne. */
    .hero { position: relative; overflow: hidden; }
    .hero > .obal { position: relative; z-index: 1; }
    #heroPlatno {
      position: absolute; inset: 0; width: 100%; height: 100%;
      pointer-events: none; opacity: 0.5;
    }

    /* ---- Pás pro školu (pro ředitele a správce sítě) ---- */
    .skola {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); gap: 10px;
      margin: 22px 0 4px;
    }
    /* jen vnější karta je flex – vnitřní blok s textem se jinak roztrhal
       na dva úzké sloupce vedle sebe */
    .skola > div {
      display: flex; gap: 10px; align-items: flex-start;
      background: var(--bg-panel); border: 1px solid var(--border); border-radius: 10px;
      padding: 12px 14px;
    }
    .skola > div > div { min-width: 0; }
    .skola .znak { font-size: 1.3rem; line-height: 1.1; }
    .skola b { display: block; font-size: 0.88rem; margin-bottom: 2px; }
    .skola span.text { color: var(--text-muted); font-size: 0.8rem; line-height: 1.45; }

    /* ---- Lišta ukázek (na projektoru se s ní skáče mezi ukázkami) ---- */
    .lista-ukazek {
      position: sticky; top: 0; z-index: 20;
      display: flex; gap: 6px; overflow-x: auto; scrollbar-width: thin;
      background: color-mix(in srgb, var(--bg-deep) 88%, transparent);
      backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--border);
      margin: 22px 0 0; padding: 9px 0;
    }
    .lista-ukazek a {
      display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
      background: var(--bg-panel); border: 1px solid var(--border); border-radius: 999px;
      padding: 6px 13px; color: var(--text-muted); text-decoration: none;
      font-size: 0.82rem; font-weight: 600;
      transition: color 0.12s ease, border-color 0.12s ease, background-color 0.12s ease;
    }
    .lista-ukazek a:hover { color: var(--text); border-color: var(--accent); }
    .lista-ukazek a.aktivni {
      background: var(--accent); border-color: var(--accent); color: #fff;
    }
    .lista-ukazek a .cislo { opacity: 0.65; font-size: 0.72rem; font-variant-numeric: tabular-nums; }

    /* ---- Karta jedné ukázky ---- */
    .demo {
      background: var(--bg-panel); border: 1px solid var(--border); border-radius: 14px;
      margin: 26px 0; overflow: hidden; box-shadow: var(--shadow);
      scroll-margin-top: 62px;          /* aby ukázku nepřekryla lepivá lišta */
      transition: border-color 0.15s ease;
    }
    .demo:hover { border-color: var(--border-strong); }
    .demo > header {
      background: linear-gradient(115deg, var(--accent-soft), transparent 62%);
    }
    .demo > header {
      display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 12px;
      padding: 16px 18px 12px; border-bottom: 1px solid var(--border);
    }
    .demo > header h2 { font-size: 1.08rem; font-weight: 650; }
    .demo > header .predmet {
      background: var(--accent-soft); color: var(--accent); border: 1px solid var(--border);
      border-radius: 999px; padding: 3px 10px; font-size: 0.74rem; font-weight: 650;
    }
    .demo > header .ukazka-stitek {
      margin-left: auto; color: var(--text-faint); font-size: 0.74rem; font-weight: 600;
      letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
      border: 1px dashed var(--border-strong); border-radius: 999px; padding: 3px 10px;
    }
    .demo > header .poradi {
      margin-left: auto; color: var(--text-faint); font-size: 0.74rem; font-weight: 700;
      font-variant-numeric: tabular-nums; letter-spacing: 0.04em;
    }
    /* pořadí už odsadilo štítek doprava, druhé auto by je od sebe roztrhlo */
    .demo > header .poradi + .ukazka-stitek { margin-left: 0; }
    .demo > header p { flex-basis: 100%; color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; }
    .demo .telo { padding: 16px 18px 18px; }
    .demo-lista { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }
    .demo-lista button { padding: 8px 13px; font-size: 0.86rem; font-weight: 500; }
    .demo-lista .napoveda { color: var(--text-faint); font-size: 0.79rem; line-height: 1.45; }
    .demo-lista .oddel { margin-left: auto; }
    .demo-lista label { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 0.84rem; }
    .demo-lista input[type=range] { accent-color: var(--accent); width: 110px; }
    .demo-lista input[type=checkbox] { accent-color: var(--accent); }

    .platno-obal {
      position: relative; background: var(--bg-input); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden;
    }
    .platno-obal canvas { display: block; width: 100%; touch-action: none; }
    .platno-obal .cedule {
      position: absolute; left: 10px; top: 9px; color: var(--text-faint);
      font-size: 0.78rem; line-height: 1.5; pointer-events: none;
      background: color-mix(in srgb, var(--bg-input) 78%, transparent);
      border-radius: 7px; padding: 5px 9px;
    }
    .platno-obal .cedule b { color: var(--text-muted); }

    /* ---- 1. Gravitační hřiště ---- */
    #gravPlatno { height: 400px; }
    .grav-udaje {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(108px, 1fr)); gap: 8px; margin-top: 10px;
    }
    .grav-udaje div {
      background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px;
    }
    .grav-udaje .popisek { color: var(--text-faint); font-size: 0.72rem; }
    .grav-udaje .hodnota { font-size: 1.02rem; font-weight: 650; font-variant-numeric: tabular-nums; }

    /* ---- 2. Periodická tabulka ---- */
    .pt-obal { display: grid; grid-template-columns: minmax(0, 1fr) 268px; gap: 14px; align-items: start; }
    .pt-obal > div { min-width: 0; }
    .pt-posuv { overflow-x: auto; padding-bottom: 6px; }
    .pt-mrizka {
      display: grid; grid-template-columns: repeat(18, minmax(30px, 1fr));
      gap: 2px; min-width: 580px;
    }
    .pt-prvek {
      aspect-ratio: 1; border: 0; border-radius: 3px; padding: 2px 0 0; cursor: pointer;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      color: #12181f; font-family: inherit; line-height: 1.05; overflow: hidden;
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }
    .pt-prvek .z { font-size: 0.46rem; opacity: 0.75; }
    .pt-prvek .zn { font-size: 0.82rem; font-weight: 700; }
    .pt-prvek .nz { font-size: 0.4rem; opacity: 0.8; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pt-prvek:hover { transform: scale(1.16); box-shadow: 0 0 0 2px var(--text); z-index: 2; }
    .pt-prvek.vybrany { box-shadow: 0 0 0 2px var(--text); z-index: 2; }
    .pt-prvek.ztlumeny { opacity: 0.16; }
    .pt-mezera { grid-column: 1 / -1; height: 7px; }

    .pt-detail {
      background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 10px;
      padding: 14px; position: sticky; top: 10px;
    }
    .pt-detail .hlava { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
    .pt-detail .znak { font-size: 2.4rem; font-weight: 700; line-height: 1; }
    .pt-detail h3 { font-size: 1.02rem; }
    .pt-detail .kat { color: var(--text-faint); font-size: 0.76rem; }
    .pt-detail .radek { display: flex; justify-content: space-between; gap: 10px; font-size: 0.8rem; padding: 3px 0; border-bottom: 1px solid var(--border); }
    .pt-detail .radek span { color: var(--text-muted); }
    .pt-detail .radek b { font-variant-numeric: tabular-nums; }
    .pt-detail .konf { font-size: 0.76rem; color: var(--text-muted); margin-top: 8px; line-height: 1.5; word-break: break-word; }
    .pt-detail canvas { display: block; width: 100%; height: 170px; margin-top: 6px; }
    .pt-legenda { display: flex; flex-wrap: wrap; gap: 4px 8px; margin-top: 10px; }
    .pt-legenda button {
      display: inline-flex; align-items: center; gap: 5px; background: none; border: 0;
      color: var(--text-muted); font-family: inherit; font-size: 0.74rem; cursor: pointer; padding: 2px 4px;
      border-radius: 5px;
    }
    .pt-legenda button:hover, .pt-legenda button.aktivni { background: var(--bg-hover); color: var(--text); }
    .pt-legenda i { width: 10px; height: 10px; border-radius: 2px; }
    .pt-hledat {
      background: var(--bg-input); border: 1px solid var(--border-strong); color: var(--text);
      border-radius: 8px; padding: 8px 12px; font-family: inherit; font-size: 0.86rem; width: 190px;
    }
    .pt-hledat:focus { outline: none; border-color: var(--accent); }
    @media (max-width: 780px) {
      /* minmax(0, 1fr), ne 1fr: sloupec by se jinak roztáhl na šířku mřížky
         prvků (580 px), .pt-posuv by neměl co posouvat a tabulka by se
         na mobilu jen oříznula */
      .pt-obal { grid-template-columns: minmax(0, 1fr); }
      .pt-detail { position: static; }
    }
    .pt-posuv { min-width: 0; }

    /* ---- 3. Aerodynamický tunel ---- */
    #tunelPlatno { height: 300px; }

    /* ---- 4. Buňka ---- */
    .bunka-obal { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px); gap: 16px; align-items: start; }
    /* Model má vlastní bílé „podložní sklo“ a drží si barvy nezávisle na motivu
       stránky – kresba i barvy zvýraznění jsou stejné jako v plné verzi. */
    .bunka-platno {
      position: relative; width: 100%; max-width: 380px; margin: auto;
      background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden;
    }
    .bunka-platno img { display: block; width: 100%; height: auto; }
    .bunka-platno svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .bunka-platno .bodywrap { position: relative; }
    /* Obrys části se zvýrazní skutečným tvarem, ne obdélníkem prohlížeče. */
    .organ { cursor: pointer; fill: transparent; stroke: transparent; stroke-width: 4; stroke-linejoin: round; outline: none; }
    .organ:hover, .organ:focus-visible { fill: #347fc22b; stroke: #246da5; outline: none; }
    .organ.vybrany { fill: #e5ae3038; stroke: #a66b00; }
    .bunka-popisek { font-size: 0.78rem; color: var(--text-muted); text-align: center; margin-top: 10px; }
    .bunka-postup { display: flex; justify-content: space-between; gap: 10px;
      font-size: 0.78rem; color: var(--text-muted); margin-top: 12px; }
    #bunkaUkazatel { width: 100%; height: 8px; accent-color: var(--accent); }

    .bunka-info {
      background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 16px; min-height: 118px;
    }
    .bunka-info .skupina {
      color: var(--accent); font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 4px;
    }
    .bunka-info h3 { font-size: 1.05rem; margin-bottom: 6px; }
    .bunka-info p, .bunka-info dd { color: var(--text-muted); font-size: 0.87rem; line-height: 1.6; }
    .bunka-info .uvod { color: var(--text); font-size: 0.93rem; margin-bottom: 10px; }
    .bunka-info dl { display: grid; gap: 3px; }
    .bunka-info dt { font-weight: 700; font-size: 0.82rem; margin-top: 8px; }
    .bunka-info .pozor {
      margin-top: 12px; padding: 9px 12px; background: var(--accent-soft);
      border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; font-size: 0.83rem;
    }
    .bunka-chipy { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .bunka-chipy button {
      background: var(--bg-control); border: 1px solid var(--border); border-radius: 9px;
      padding: 6px 10px; color: var(--text-muted); font-family: inherit; font-size: 0.8rem; cursor: pointer;
    }
    .bunka-chipy button:hover { background: var(--bg-hover); color: var(--text); }
    .bunka-chipy button.vybrany { border-color: var(--accent); background: var(--accent-soft); color: var(--text); }
    .bunka-chipy button.videny::after { content: ' ✓'; }
    .bunka-typ {
      flex: none; background: var(--accent-soft); border: 1px solid var(--accent); color: var(--text);
      border-radius: 999px; padding: 6px 14px; font-size: 0.84rem; font-weight: 600;
    }
    @media (max-width: 760px) { .bunka-obal { grid-template-columns: 1fr; } }

    /* ---- 5. Graf funkce ---- */
    #grafPlatno { height: 320px; }
    .graf-vzorec {
      font-size: 1.15rem; font-weight: 650; text-align: center; margin-bottom: 10px;
      font-variant-numeric: tabular-nums;
    }
    .graf-vzorec .a, .jezdec.a { color: var(--accent); }
    .graf-vzorec .b, .jezdec.b { color: var(--warn); }
    .graf-vzorec .c, .jezdec.c { color: var(--ok); }
    .jezdec { font-size: 1rem; font-style: italic; }
    .graf-fakta { color: var(--text-muted); font-size: 0.84rem; line-height: 1.6; margin-top: 10px; }
    .graf-fakta b { color: var(--text); font-variant-numeric: tabular-nums; }

    /* ---- 6. Procvičování ---- */
    .plocha {
      background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius);
      padding: 22px 20px; text-align: center; min-height: 300px;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15px;
    }
    .plocha .zadani { color: var(--text-muted); font-size: 0.98rem; }
    .veta-uloha { font-size: clamp(1.3rem, 4vw, 1.9rem); font-weight: 650; line-height: 1.5; }
    .veta-uloha .spoust { color: var(--zvyraz-text); }
    .veta-uloha .mezera {
      display: inline-block; min-width: 1.1em; border-bottom: 3px solid var(--accent);
      text-align: center; color: var(--accent);
    }
    .veta-uloha .mezera.doplneno { color: var(--ok-text); border-color: var(--ok-text); }
    .moznosti { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .moznosti button {
      min-width: 104px; padding: 13px 16px; border-radius: 12px; cursor: pointer;
      background: var(--bg-control); border: 1px solid var(--border-strong); color: var(--text);
      font-family: inherit; font-size: 1.02rem; font-weight: 600;
      transition: transform 0.12s ease, border-color 0.12s ease;
    }
    .moznosti button:hover { border-color: var(--accent); transform: translateY(-3px); }
    .moznosti button.spravne { background: var(--ok); border-color: var(--ok); color: #fff; }
    .moznosti button.spatne { background: var(--danger); border-color: var(--danger); color: #fff; }
    .odezva { font-size: 1rem; font-weight: 600; min-height: 26px; }
    .odezva.ok { color: var(--ok-text); }
    .odezva.chyba { color: var(--danger-text); }
    .pravidlo {
      display: flex; gap: 10px; text-align: left; max-width: 620px;
      background: var(--bg-panel); border: 1px solid var(--border); border-left: 3px solid var(--ok);
      border-radius: 8px; padding: 12px 14px; color: var(--text-muted); font-size: 0.9rem; line-height: 1.6;
    }
    .pravidlo .znak { font-size: 1.3rem; line-height: 1.2; }
    .pravidlo b { color: var(--text); }
    @keyframes trhnuti {
      0%, 100% { transform: translateX(0); } 20% { transform: translateX(-6px); }
      40% { transform: translateX(6px); } 60% { transform: translateX(-4px); } 80% { transform: translateX(4px); }
    }
    .trhni { animation: trhnuti 0.35s; }

    /* ---- 7. Generátor testů ---- */
    .test-volby { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: flex-end; margin-bottom: 12px; }
    .test-volby label { display: flex; flex-direction: column; gap: 4px; color: var(--text-faint); font-size: 0.76rem; }
    .test-volby select, .test-volby input {
      background: var(--bg-input); border: 1px solid var(--border-strong); color: var(--text);
      border-radius: 8px; padding: 8px 10px; font-family: inherit; font-size: 0.88rem;
    }
    .test-volby select:focus, .test-volby input:focus { outline: none; border-color: var(--accent); }
    .test-volby input { width: 108px; text-transform: uppercase; letter-spacing: 0.08em; }

    /* Arch je vždycky bílý papír – proto tady schválně NEJSOU proměnné motivu.
       Ve světlém režimu by se jinak čísla úloh a linky na jméno slily s papírem
       (stejná past je popsaná u plného generátoru pracovních listů). */
    .list {
      background: #ffffff; color: #17191c; border: 1px solid var(--border);
      border-radius: 8px; padding: 22px clamp(16px, 3vw, 30px); margin-top: 14px;
    }
    .list h3 { font-size: 1.05rem; margin-bottom: 2px; }
    .list .pokyn { font-size: 0.86rem; color: #4b535b; margin-bottom: 12px; }
    .list .hlavicka {
      display: flex; flex-wrap: wrap; gap: 8px 22px; border-bottom: 1px solid #c9ced4;
      padding-bottom: 10px; margin-bottom: 14px; font-size: 0.82rem; color: #4b535b;
    }
    .list .hlavicka span { flex: 1 1 150px; border-bottom: 1px dotted #9aa1a8; padding-bottom: 2px; }
    .list ol { columns: 2; column-gap: 30px; list-style: none; counter-reset: uloha; }
    .list li {
      counter-increment: uloha; break-inside: avoid; margin-bottom: 11px;
      display: flex; gap: 8px; align-items: baseline; font-size: 0.94rem;
    }
    .list li::before {
      content: counter(uloha) "."; color: #6b7480; font-size: 0.78rem;
      min-width: 1.4em; text-align: right; flex: none;
    }
    .list li .zadani-listu { flex: 1; }
    .list li .misto { display: inline-block; min-width: 3.4em; border-bottom: 1px solid #9aa1a8; }
    /* Nadpis oddílu na archu – pokyn pro následující úlohy. Nepočítá se do
       číslování a nesmí zůstat na konci sloupce sám bez svých úloh. */
    .list li.oddil {
      counter-increment: none; display: block; margin: 14px 0 8px;
      font-size: 0.82rem; color: #3d444b; break-after: avoid; break-inside: avoid;
    }
    .list li.oddil:first-child { margin-top: 0; }
    .list li.oddil::before { content: none; }
    .list li.oddil b { color: #17191c; }
    .list .reseni { border-top: 1px solid #c9ced4; margin-top: 12px; padding-top: 10px; font-size: 0.84rem; color: #3d444b; }
    .list .reseni b { color: #17191c; }
    .list .kod { margin-top: 12px; font-size: 0.74rem; color: #6b7480; letter-spacing: 0.06em; }
    @media (max-width: 620px) { .list ol { columns: 1; } }

    /* Tisk: z celé stránky jde na papír jen vygenerovaný list.
       Schovává se výčtem „všechno kromě“, ne seznamem konkrétních prvků –
       ten se rozešel s obsahem, jakmile stránka dostala pás pro školu
       a lištu ukázek, a ty pak vyjely na papír nad arch. */
    /* Okraj tiskové stránky. Patří MIMO @media print – vnořené @page Chrome
       zahodí a arch pak doléhá na ořezovou hranu (první znaky řádků se ztrácejí).
       Na obrazovku @page stejně nemá vliv. */
    @page { margin: 14mm; }

    @media print {
      body > *:not(.obal),
      .obal > *:not(#test),
      .demo-lista, .test-volby, #test > header { display: none !important; }
      body { background: #fff; }
      .obal { max-width: none; padding: 0; }
      .demo { border: 0; box-shadow: none; margin: 0; background: none; }
      .demo .telo { padding: 0; }
      .list { border: 0; border-radius: 0; padding: 2mm; margin: 0; }
      .list .reseni { break-before: page; }
    }

    /* ---- Závěr ---- */
    .zaver {
      background: linear-gradient(120deg, var(--accent-soft), transparent 75%);
      border: 1px solid var(--border); border-radius: 14px; padding: clamp(20px, 4vw, 30px); margin: 30px 0;
    }
    .zaver h2 { font-size: 1.2rem; margin-bottom: 8px; }
    .zaver p { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; max-width: 640px; }
    .pata { color: var(--text-faint); font-size: 0.79rem; line-height: 1.6; padding: 16px 0 40px; }
    .pata a { color: var(--text-muted); }
    .skryto { display: none !important; }
  </style>
</head>
<body>

<div class="hero">
  <canvas id="heroPlatno" aria-hidden="true"></canvas>
  <div class="obal">
    <h1><svg class="symbol" viewBox="0 0 655 488" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g transform="translate(0,488) scale(0.1,-0.1)"><path d="M5911 4824 c-708 -239 -1389 -584 -1876 -950 -352 -264 -547 -485 -738 -835 -22 -40 -20 -42 -92 91 -182 335 -566 695 -1067 999 -428 259 -1117 569 -1582 710 -225 69 -459 -49 -526 -266 -33 -109 -31 -4397 3 -4463 39 -78 132 -121 215 -100 247 62 474 296 558 575 17 56 18 153 21 1635 1 866 2 1588 3 1604 0 40 33 34 285 -50 976 -324 1596 -753 1810 -1254 117 -274 117 -276 124 -1170 7 -837 2 -784 71 -843 111 -95 297 -66 363 56 22 42 22 42 28 817 5 741 6 779 26 865 124 529 489 910 1200 1252 354 169 962 387 984 351 5 -7 9 -727 9 -1599 0 -1587 0 -1587 25 -1673 45 -155 115 -267 238 -382 223 -208 448 -238 531 -72 26 52 26 52 26 2204 0 1529 -3 2168 -11 2206 -41 199 -219 348 -413 348 -35 0 -102 -17 -215 -56z"/></g></svg> Metodus</h1>
    <p class="claim">Sedm <b>živých ukázek</b> přímo tady na stránce – ne obrázky, ne video.
      Klikejte, táhněte, posouvejte. Přesně tohle dělají žáci v Metodusu, jen ve zkrácené podobě.</p>
    <p class="drobne">Interaktivní procvičování a názorné simulace pro celou základní školu.
      Všechno běží přímo v prohlížeči – nic se neinstaluje a po prvním otevření to jede i bez internetu.</p>

    <div class="cisla" id="cisla"></div>

    <div class="tlacitka">
      <a class="hlavni" href="#grav">🪐 Skočit na první ukázku</a>
      <a href="#test">🖨️ Vyrobit test</a>
      <button type="button" id="btnTema" title="Přepnout světlý / tmavý režim">🌙 Motiv</button>
    </div>
  </div>
</div>

<div class="obal">

  <!-- Čtyři věty pro toho, kdo o nasazení rozhoduje. Schválně jen o provozu
       (instalace, síť, data, osnova) – o ceně a účtech tu nic neslibujeme. -->
  <div class="skola">
    <div><span class="znak" aria-hidden="true">🖥️</span><div>
      <b>Nic se neinstaluje</b><span class="text">Běží v prohlížeči – na počítači, tabletu i interaktivní tabuli.</span></div></div>
    <div><span class="znak" aria-hidden="true">📴</span><div>
      <b>Funguje offline</b><span class="text">Po prvním otevření běží i bez sítě – i na starším notebooku.</span></div></div>
    <div><span class="znak" aria-hidden="true">🔒</span><div>
      <b>Data zůstávají ve škole</b><span class="text">Vše počítá prohlížeč. Nic se nikam neodesílá.</span></div></div>
    <div><span class="znak" aria-hidden="true">📐</span><div>
      <b>Podle osnovy ZŠ</b><span class="text">Každé téma má svůj předmět a ročník, ne jen název aplikace.</span></div></div>
  </div>

  <nav class="lista-ukazek" id="listaUkazek" aria-label="Přejít na ukázku"></nav>

  <!-- ================= 1. Gravitační hřiště ================= -->
  <section class="demo" id="grav" data-nav="🪐 Gravitace">
    <header>
      <span class="predmet">⚛️ Fyzika · 6.–9. ročník</span>
      <h2>🪐 Gravitační hřiště</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p><b>Táhněte myší a pusťte</b> – jako prakem vystřelíte planetku. Ještě než pustíte,
        je vidět <b>předpověď dráhy</b>: zeleně oběžná dráha, červeně pád do hvězdy,
        oranžově únik do prázdna. Tlačítkem <b>🧲 Ukázat gravitaci</b> se k tomu přikreslí
        pole kolem hvězdy a síly působící na planetky.</p>
    </header>
    <div class="telo">
      <div class="platno-obal">
        <canvas id="gravPlatno"></canvas>
        <div class="cedule" id="gravCedule"><b>Táhněte a pusťte.</b></div>
      </div>
      <div class="grav-udaje" id="gravUdaje"></div>
      <div class="demo-lista">
        <button type="button" id="gravOrbita">🌍 Kruhová dráha</button>
        <button type="button" id="gravPole">🧲 Ukázat gravitaci</button>
        <button type="button" id="gravStop">⏸ Pauza</button>
        <button type="button" id="gravSmaz">🧹 Vymazat</button>
        <span class="napoveda">Počítá se Newtonův gravitační zákon (leapfrog), proto z toho vycházejí
          skutečné elipsy – i Keplerovy zákony. Předpověď kreslí <b>tentýž</b> výpočet,
          takže co je vidět při míření, to se opravdu stane.</span>
      </div>
    </div>
  </section>

  <!-- ================= 2. Periodická tabulka ================= -->
  <section class="demo" id="prvky" data-nav="⚛️ Prvky">
    <header>
      <span class="predmet">⚗️ Chemie · 8.–9. ročník</span>
      <h2>⚛️ Periodická tabulka prvků</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p>Všech 118 prvků. <b>Klepněte na kterýkoli</b> – vpravo se dopočítá elektronová konfigurace
        a rozběhne se Bohrův model se skutečným počtem elektronů ve slupkách.</p>
    </header>
    <div class="telo">
      <div class="pt-obal">
        <div>
          <div class="pt-posuv"><div class="pt-mrizka" id="ptMrizka"></div></div>
          <div class="pt-legenda" id="ptLegenda"></div>
        </div>
        <div class="pt-detail" id="ptDetail"></div>
      </div>
      <div class="demo-lista">
        <input type="search" class="pt-hledat" id="ptHledat" placeholder="🔍 Hledat prvek…" autocomplete="off">
        <button type="button" id="ptNahodny">🎲 Náhodný prvek</button>
        <span class="napoveda">Skupiny v legendě fungují jako filtr.</span>
      </div>
    </div>
  </section>

  <!-- ================= 3. Aerodynamický tunel ================= -->
  <section class="demo" id="tunel" data-nav="💨 Tunel">
    <header>
      <span class="predmet">⚛️ Fyzika · 7.–9. ročník</span>
      <h2>💨 Vítr a překážky – aerodynamický tunel</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p><b>Táhněte překážku</b> napříč proudem a měňte její velikost. Barva částic ukazuje rychlost:
        po stranách se vzduch zrychlí, před překážkou a za ní se zastaví.</p>
    </header>
    <div class="telo">
      <div class="platno-obal">
        <canvas id="tunelPlatno"></canvas>
        <div class="cedule" id="tunelCedule"></div>
      </div>
      <div class="demo-lista">
        <label>Velikost <input type="range" id="tunelR" min="18" max="70" value="42"></label>
        <label>Vítr <input type="range" id="tunelV" min="20" max="150" value="80"></label>
        <label><input type="checkbox" id="tunelStopy" checked> Stopy proudění</label>
        <span class="napoveda">Rychlejší proud = nižší tlak. Právě z toho vzniká vztlak na křídle.</span>
      </div>
    </div>
  </section>

  <!-- ================= 4. Stavba buňky ================= -->
  <section class="demo" id="bunka" data-nav="🔬 Buňka">
    <header>
      <span class="predmet">🧬 Přírodopis · 6. ročník</span>
      <h2>🔬 Stavba buňky</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p><b>Klepněte na část buňky</b> v modelu nebo v seznamu – dozvíte se, jak vypadá,
        co dělá a na co si u ní dát pozor. Ukázka nabízí <b>rostlinnou</b> buňku;
        plná verze i živočišnou a jejich srovnání.</p>
    </header>
    <div class="telo">
      <div class="bunka-obal">
        <div>
          <div class="bunka-platno" id="bunkaStage"></div>
          <p class="bunka-popisek" id="bunkaPopisek"></p>
          <div class="bunka-postup">
            <span id="bunkaStav"></span><span>✓ prohlédnutá část</span>
          </div>
          <progress id="bunkaUkazatel" value="0" max="12" aria-label="Prohlédnuté části buňky"></progress>
        </div>
        <div>
          <div class="bunka-info" id="bunkaInfo"></div>
          <div class="bunka-chipy" id="bunkaChipy" aria-label="Části buňky"></div>
        </div>
      </div>
      <div class="demo-lista">
        <span class="bunka-typ">🌱 Rostlinná buňka</span>
        <span class="napoveda">Model není v měřítku a nezobrazuje všechny buněčné struktury.
          Klávesnicí: Tab vybere část, Enter nebo mezerník otevře vysvětlení.</span>
      </div>
    </div>
  </section>

  <!-- ================= 5. Graf funkce ================= -->
  <section class="demo" id="graf" data-nav="📈 Funkce">
    <header>
      <span class="predmet">🔢 Matematika · 9. ročník</span>
      <h2>📈 Kvadratická funkce naživo</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p><b>Posouvejte koeficienty</b> a sledujte, co se dělá s parabolou. Vrchol, průsečíky s osami
        i diskriminant se přepočítávají okamžitě.</p>
    </header>
    <div class="telo">
      <div class="graf-vzorec" id="grafVzorec"></div>
      <div class="platno-obal"><canvas id="grafPlatno"></canvas></div>
      <div class="demo-lista">
        <label><b class="jezdec a">a</b> <input type="range" id="grafA" min="-30" max="30" value="10" step="1"></label>
        <label><b class="jezdec b">b</b> <input type="range" id="grafB" min="-60" max="60" value="0" step="1"></label>
        <label><b class="jezdec c">c</b> <input type="range" id="grafC" min="-50" max="50" value="-20" step="1"></label>
        <button type="button" id="grafReset">↩ Zpět na y = x²</button>
      </div>
      <div class="graf-fakta" id="grafFakta"></div>
    </div>
  </section>

  <!-- ================= 6. Procvičování ================= -->
  <section class="demo" id="uloha" data-nav="✍️ Procvičování">
    <header>
      <span class="predmet">📖 Napříč předměty</span>
      <h2>✍️ Procvičování, které vysvětluje</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p>Tohle je jádro celého webu: špatná odpověď úlohu <b>nezavírá</b>, jen zaklepe.
        Po správné odpovědi přijde kartička <b>proč</b> to tak je.</p>
    </header>
    <div class="telo">
      <div class="plocha" id="plocha"></div>
      <div class="demo-lista">
        <button type="button" id="btnDalsi">Další úloha →</button>
        <span class="napoveda" id="ulohaSkore"></span>
      </div>
    </div>
  </section>

  <!-- ================= 7. Generátor testů ================= -->
  <section class="demo" id="test" data-nav="🖨️ Testy">
    <header>
      <span class="predmet">🍎 Pro učitele · 1.–9. ročník</span>
      <h2>🖨️ Generátor testů</h2>
      <span class="ukazka-stitek">Ukázková verze</span>
      <p>Vyberte ročník, téma a obtížnost – <b>list se složí sám</b> a dá se rovnou vytisknout.
        Stejný <b>kód listu</b> vyrobí pokaždé stejný test, takže se dá zadat i za rok znovu.</p>
    </header>
    <div class="telo">
      <div class="test-volby">
        <label>Ročník <select id="testRocnik"></select></label>
        <label>Téma <select id="testTema"></select></label>
        <label>Obtížnost <select id="testObtiznost">
          <option value="easy">lehká</option>
          <option value="medium" selected>střední</option>
          <option value="hard">těžká</option>
        </select></label>
        <label>Úloh <select id="testPocet">
          <option>6</option><option selected>10</option><option>16</option><option>20</option>
        </select></label>
        <label>Kód listu <input type="text" id="testKod" maxlength="8" autocomplete="off"></label>
      </div>
      <div class="demo-lista">
        <button type="button" id="testNovy">🎲 Nový list</button>
        <button type="button" id="testReseni">👁 Ukázat řešení</button>
        <button type="button" id="testTisk">🖨️ Vytisknout</button>
        <span class="napoveda">Tiskne se jen arch – ovládání ani zbytek stránky na papír nejdou.</span>
      </div>
      <div class="list" id="testList"></div>
    </div>
  </section>

  <section class="zaver">
    <h2>A tohle byl jen ochutnávkový talíř</h2>
    <p id="zaverText">Plné verze umí mnohem víc: gravitační hřiště kreslí Keplerovy plochy a dráhové
      elementy, periodická tabulka má popisy a kvíz, tunel počítá odpor tvaru, buňka má i živočišnou
      variantu a fotografii modelu, generátor listů má přes sto témat, záhlaví se školou a tisk
      řešení na zvláštní stránce. A vedle nich je ještě celá osnova od první do deváté třídy.</p>
  </section>

  <p class="pata">
    Metodus běží celý v prohlížeči – žádná data neopouštějí počítač.
    Obsah slouží k procvičování, ne jako náhrada učebnice.
  </p>
</div>

<script src="../apps.js"></script>
<script>
/* ============================================================
   Metodus – živé ukázky.

   Stránka je čistě ukázková a záměrně nikam neodkazuje – ani do Metodusu,
   ani na nadřazený web. Běží stejně uvnitř rozcestníku (iframe), samostatně
   ve složce Metodusu i vytržená jinam jako jediný soubor.

   Jediné, co se podle prostředí liší, jsou čísla v hlavičce: berou se
   z katalogu `apps.js`, a když se katalog nenačte, blok se odstraní.

   POZOR: tenhle soubor je zdrojem i pro samostatné nasazení na vlastní
   GitHub Pages (složka ../metodus-ukazka/ vedle repozitáře webu). Po každé
   úpravě je potřeba tam spustit ./aktualizuj.sh, jinak se verze rozejdou.

   Ukázky jsou zkrácené verze skutečných aplikací; data (prvky, organely,
   schéma buňky) jsou převzatá z jejich zdrojů, aby ukázka neříkala něco
   jiného než plná verze.
   ============================================================ */
const $ = id => document.getElementById(id);
const vMetodusu = typeof KATALOG_SEKCE !== 'undefined';

/* ---- Čísla z katalogu ---------------------------------------------------
   Jen když je katalog po ruce; jinak by blok lhal nulami. */
if (vMetodusu) {
  const vsechny = KATALOG_SEKCE.flatMap(s => s.polozky).filter(p => p.stav !== 'plan');
  const rocniku = new Set(vsechny.flatMap(p => p.rocniky || [])).size;
  [[vsechny.length, 'hotových aplikací'], [KATALOG_PREDMETY.length, 'předmětů'],
   [rocniku, 'ročníků ZŠ'], [KATALOG_SEKCE.length, 'tematických okruhů']].forEach(([h, p]) => {
    const d = document.createElement('div');
    d.innerHTML = `<div class="hodnota">${h}</div><div class="popisek">${p}</div>`;
    $('cisla').appendChild(d);
  });
} else {
  $('cisla').remove();
  $('zaverText').textContent = 'Plné verze těchto aplikací i celá osnova od první do deváté '
    + 'třídy jsou ve výukovém webu Metodus.';
}

/* ---- Podpis pro samostatně poslaný soubor ----------------------------
   Uvnitř Metodusu kreslí podpis pruh z podpis.js a v rámu patří nadřazené
   stránce. Když ale stránka putuje sama (bez podpis.js), nesměla by být
   bez autora – doplní se proto do patičky. Čeká se na `load`, protože
   podpis.js je `defer` a v tu chvíli ještě nemusí být hotový. */
window.addEventListener('load', () => {
  if (window.parent !== window || document.getElementById('autor-podpis')) return;
  const p = document.createElement('span');
  p.textContent = ' · © Metodus · hdm@seznam.cz';
  document.querySelector('.pata').appendChild(p);
});

/* ---- Motiv ------------------------------------------------------------
   Vlastní přepínač s vlastním klíčem (`metodus_ukazky_tema`). Schválně se nesdílí
   s `webapp_theme` zbytku Metodusu: tahle stránka startuje ve světlém motivu
   a přepnutí tady nemá překlopit celý web (ani naopak). */
function popisTemata() {
  const btn = $('btnTema');
  btn.textContent = document.documentElement.dataset.theme === 'light' ? '☀️ Motiv' : '🌙 Motiv';
}
{
  const btn = $('btnTema');
  const jeSvetlo = () => document.documentElement.dataset.theme === 'light';
  // motiv už nastavil skript v hlavičce, tady se jen dopíše popisek tlačítka
  popisTemata();
  btn.addEventListener('click', () => {
    const svetlo = !jeSvetlo();
    if (svetlo) document.documentElement.dataset.theme = 'light';
    else delete document.documentElement.dataset.theme;
    try { localStorage.setItem('metodus_ukazky_tema', svetlo ? 'light' : 'dark'); } catch { /* nevadí */ }
    popisTemata();
  });
}

/* ---- Barvy pro plátna -------------------------------------------------
   Canvas neumí var(--…), barvy se proto čtou z CSS a přepočítají při každé
   změně motivu – hlídá ji MutationObserver na atributu data-theme. */
const TEMA = {};
function nactiBarvy() {
  const s = getComputedStyle(document.documentElement);
  ['--bg-input', '--bg-panel', '--text', '--text-muted', '--text-faint', '--border',
   '--accent', '--ok', '--warn', '--danger'].forEach(k => {
    TEMA[k.slice(2)] = s.getPropertyValue(k).trim();
  });
  TEMA.svetlo = document.documentElement.dataset.theme === 'light';
}
nactiBarvy();
new MutationObserver(() => {
  nactiBarvy();
  popisTemata();
}).observe(document.documentElement, { attributeFilter: ['data-theme'] });

/* ---- Plátno a smyčka --------------------------------------------------
   Každá ukázka běží jen tehdy, když je opravdu vidět. Několik současně
   běžících animací by jinak zbytečně vytěžovalo notebook i tablet. */
function nastavPlatno(cv) {
  const ctx = cv.getContext('2d');
  const zmer = () => {
    const r = cv.getBoundingClientRect();
    if (!r.width) return;
    cv.width = Math.round(r.width * devicePixelRatio);
    cv.height = Math.round(r.height * devicePixelRatio);
    ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
  };
  new ResizeObserver(zmer).observe(cv);
  zmer();
  return { ctx, w: () => cv.clientWidth, h: () => cv.clientHeight };
}

function animuj(prvek, krok) {
  let id = null, minule = 0;
  const smycka = t => {
    const dt = Math.min((t - minule) / 1000, 0.05);
    minule = t;
    krok(dt);
    id = requestAnimationFrame(smycka);
  };
  new IntersectionObserver(([z]) => {
    if (z.isIntersecting && id === null) { minule = performance.now(); id = requestAnimationFrame(smycka); }
    else if (!z.isIntersecting && id !== null) { cancelAnimationFrame(id); id = null; }
  }, { threshold: 0.01 }).observe(prvek);
}

/* pozice ukazatele v souřadnicích plátna (myš i dotyk) */
function bod(cv, e) {
  const r = cv.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}

/* ---- Lišta ukázek a číslování karet -----------------------------------
   Na projektoru se s lištou skáče mezi ukázkami bez rolování; zvýrazněná
   položka zároveň říká, kde v pořadí zrovna jsme. */
{
  const sekce = [...document.querySelectorAll('.demo[data-nav]')];
  const lista = $('listaUkazek');
  const odkazy = new Map();
  const VYSKA_LISTY = 56;

  sekce.forEach((sec, i) => {
    const a = document.createElement('a');
    a.href = '#' + sec.id;
    a.innerHTML = `<span class="cislo">${i + 1}</span>${sec.dataset.nav}`;
    // Skok si řídíme sami: samotné `scroll-margin-top` na skok z lišty
    // nestačilo (karta skončila schovaná pod lepivou lištou) a plynulé
    // rolování se navíc na projektoru čte líp než střih.
    a.addEventListener('click', ev => {
      ev.preventDefault();
      const kam = sec.getBoundingClientRect().top + window.scrollY - VYSKA_LISTY;
      window.scrollTo({ top: kam, behavior: 'smooth' });
      history.replaceState(null, '', '#' + sec.id);
    });
    lista.appendChild(a);
    odkazy.set(sec.id, a);

    const poradi = document.createElement('span');
    poradi.className = 'poradi';
    poradi.textContent = `${i + 1} / ${sekce.length}`;
    sec.querySelector('header .ukazka-stitek').before(poradi);
  });

  // Zvýrazní se ukázka, která právě prochází středem okna – proto ten
  // rootMargin: pásmo je vysoké pár procent kolem poloviny výšky.
  // Stejně se zachovají i odkazy z úvodního pruhu.
  document.querySelectorAll('.tlacitka a[href^="#"]').forEach(a => {
    a.addEventListener('click', ev => {
      const cil = document.querySelector(a.getAttribute('href'));
      if (!cil) return;
      ev.preventDefault();
      window.scrollTo({ top: cil.getBoundingClientRect().top + window.scrollY - VYSKA_LISTY, behavior: 'smooth' });
    });
  });

  // Vede se seznam ukázek v pásmu kolem středu okna, ne jen poslední změna:
  // nad první ukázkou (v hlavičce) a pod poslední není v pásmu nic a lišta
  // nemá co zvýrazňovat – jinak by tam svítila naposledy viděná položka.
  const vPasmu = new Set();
  const sledovac = new IntersectionObserver(zaznamy => {
    zaznamy.forEach(z => {
      if (z.isIntersecting) vPasmu.add(z.target.id);
      else vPasmu.delete(z.target.id);
    });
    const aktivni = sekce.find(sec => vPasmu.has(sec.id));
    lista.querySelectorAll('a').forEach(x => x.classList.remove('aktivni'));
    if (!aktivni) return;
    const a = odkazy.get(aktivni.id);
    a.classList.add('aktivni');
    // Posouvá se výhradně lišta, ne stránka: scrollIntoView na lepivém prvku
    // dorovnával i svislé rolování a rušil tím doskok pod lištu.
    lista.scrollTo({ left: Math.max(0, a.offsetLeft - 14), behavior: 'smooth' });
  }, { rootMargin: '-45% 0px -50% 0px' });
  sekce.forEach(sec => sledovac.observe(sec));
}

/* ---- Síť uzlů v hlavičce ---------------------------------------------
   Značka Metodusu je uzel, hlavička na to hraje sítí teček a spojnic.
   Je to čistě kulisa: pod obsahem, bez klikání a v tichém režimu
   (prefers-reduced-motion) se nakreslí jen jednou a zůstane stát. */
{
  const cv = $('heroPlatno');
  const P = nastavPlatno(cv);
  const klid = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let uzly = [], sirka = 0;

  function nasyp() {
    const w = P.w(), h = P.h();
    sirka = w;
    const pocet = Math.min(46, Math.round(w * h / 16000));
    uzly = Array.from({ length: pocet }, () => ({
      x: Math.random() * w, y: Math.random() * h,
      vx: (Math.random() - 0.5) * 9, vy: (Math.random() - 0.5) * 9,
    }));
  }
  nasyp();

  function kresli(dt) {
    const { ctx } = P, w = P.w(), h = P.h();
    if (w !== sirka) nasyp();
    ctx.clearRect(0, 0, w, h);

    if (!klid) {
      for (const u of uzly) {
        u.x += u.vx * dt; u.y += u.vy * dt;
        if (u.x < 0 || u.x > w) u.vx *= -1;
        if (u.y < 0 || u.y > h) u.vy *= -1;
      }
    }
    ctx.strokeStyle = TEMA.accent;
    ctx.lineWidth = 1;
    for (let i = 0; i < uzly.length; i++) {
      for (let j = i + 1; j < uzly.length; j++) {
        const d = Math.hypot(uzly[i].x - uzly[j].x, uzly[i].y - uzly[j].y);
        if (d > 150) continue;
        ctx.globalAlpha = (1 - d / 150) * 0.3;
        ctx.beginPath();
        ctx.moveTo(uzly[i].x, uzly[i].y); ctx.lineTo(uzly[j].x, uzly[j].y);
        ctx.stroke();
      }
    }
    ctx.fillStyle = TEMA.accent;
    for (const u of uzly) {
      ctx.globalAlpha = 0.5;
      ctx.beginPath(); ctx.arc(u.x, u.y, 1.8, 0, 7); ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  if (klid) { requestAnimationFrame(() => kresli(0)); new ResizeObserver(() => kresli(0)).observe(cv); }
  else animuj(cv, kresli);
}

/* ============================================================
   1. GRAVITAČNÍ HŘIŠTĚ
   Zkrácená verze obsah/gravitacni_hriste.html – stejná fyzika
   (leapfrog kick-drift-kick), bez Keplerových ploch a panelu elementů.
   ============================================================ */
{
  const cv = $('gravPlatno');
  const P = nastavPlatno(cv);
  const MU = 12e6;          // gravitační parametr hvězdy (px³/s²)
  const R_HVEZDA = 15;      // poloměr hvězdy v pixelech
  const MAX_TELES = 8;
  const BARVY = ['#6aa6fd', '#e06666', '#7fd48f', '#e6c87a', '#c98bd4', '#7fd4d4', '#f0975a'];
  let telesa = [], jiskry = [], hvezdicky = [], dalsiBarva = 0;
  let bezi = true, mireni = null, pocty = { shorelo: 0, uniklo: 0 };
  // Zobrazení pole a vektorů je výchozí VYPNUTÉ – prázdný vesmír s jednou
  // dráhou je čitelnější a mřížka šipek se zapne, až když o gravitaci jde.
  // (Na fyziku to nemá vliv, ta běží pořád.)
  let ukazGravitaci = false;

  const stred = () => ({ x: P.w() / 2, y: P.h() / 2 });

  function pozadi() {
    hvezdicky = [];
    for (let i = 0; i < 120; i++) {
      hvezdicky.push({ x: Math.random(), y: Math.random(), a: Math.random() * 0.5 + 0.15 });
    }
  }
  pozadi();

  function zrychleni(x, y) {
    const s = stred(), dx = s.x - x, dy = s.y - y;
    const r2 = dx * dx + dy * dy, r = Math.sqrt(r2);
    const a = MU / Math.max(r2, 1);
    return { ax: a * dx / r, ay: a * dy / r, r };
  }

  // leapfrog: udrží energii dráhy stabilní, elipsy se nerozpadají
  function krok(t, h) {
    let a = zrychleni(t.x, t.y);
    t.vx += a.ax * h / 2; t.vy += a.ay * h / 2;
    t.x += t.vx * h; t.y += t.vy * h;
    a = zrychleni(t.x, t.y);
    t.vx += a.ax * h / 2; t.vy += a.ay * h / 2;
    return a.r;
  }

  // dráhové elementy ze stavového vektoru – čísla v panelu nikdy nemluví
  // jinak než nakreslený pohyb, protože pocházejí ze stejných hodnot
  function elementy(t) {
    const s = stred(), x = t.x - s.x, y = t.y - s.y;
    const r = Math.hypot(x, y), v2 = t.vx * t.vx + t.vy * t.vy;
    const eps = v2 / 2 - MU / r;
    const rv = x * t.vx + y * t.vy;
    const ex = ((v2 - MU / r) * x - rv * t.vx) / MU, ey = ((v2 - MU / r) * y - rv * t.vy) / MU;
    const e = Math.hypot(ex, ey), a = -MU / (2 * eps);
    return { r, v: Math.sqrt(v2), e, a, vazane: eps < 0,
             T: eps < 0 ? 2 * Math.PI * Math.sqrt(a * a * a / MU) : Infinity };
  }

  function novaPlanetka(x, y, vx, vy) {
    telesa.push({ x, y, vx, vy, barva: BARVY[dalsiBarva++ % BARVY.length], stopa: [], obehy: 0, uhel: null });
    if (telesa.length > MAX_TELES) telesa.shift();
  }

  function vybuch(x, y, barva) {
    for (let i = 0; i < 22; i++) {
      const u = Math.random() * Math.PI * 2, r = 40 + Math.random() * 90;
      jiskry.push({ x, y, vx: Math.cos(u) * r, vy: Math.sin(u) * r, zivot: 1, barva });
    }
  }

  cv.addEventListener('pointerdown', e => {
    mireni = { ...bod(cv, e), mx: bod(cv, e).x, my: bod(cv, e).y };
    try { cv.setPointerCapture(e.pointerId); } catch { /* nedůvěryhodná událost v testu */ }
  });
  cv.addEventListener('pointermove', e => {
    if (!mireni) return;
    const b = bod(cv, e);
    mireni.mx = b.x; mireni.my = b.y;
  });
  cv.addEventListener('pointerup', () => {
    if (!mireni) return;
    const vx = (mireni.x - mireni.mx) * 1.7, vy = (mireni.y - mireni.my) * 1.7;
    if (Math.hypot(vx, vy) > 6) novaPlanetka(mireni.x, mireni.y, vx, vy);
    mireni = null;
  });
  cv.addEventListener('pointercancel', () => { mireni = null; });

  $('gravOrbita').addEventListener('click', () => {
    const s = stred(), r = Math.min(P.w(), P.h()) * 0.34;
    const u = Math.random() * Math.PI * 2, v = Math.sqrt(MU / r);
    novaPlanetka(s.x + Math.cos(u) * r, s.y + Math.sin(u) * r, -Math.sin(u) * v, Math.cos(u) * v);
  });
  $('gravStop').addEventListener('click', e => {
    bezi = !bezi;
    e.currentTarget.textContent = bezi ? '⏸ Pauza' : '▶ Spustit';
  });
  $('gravSmaz').addEventListener('click', () => { telesa = []; jiskry = []; pocty = { shorelo: 0, uniklo: 0 }; });
  $('gravPole').addEventListener('click', e => {
    ukazGravitaci = !ukazGravitaci;
    e.currentTarget.textContent = ukazGravitaci ? '🧲 Skrýt gravitaci' : '🧲 Ukázat gravitaci';
  });

  const udaje = [['telesa', 'planetek'], ['obehy', 'oběhů'], ['perioda', 'doba oběhu'],
                 ['vystrednost', 'výstřednost e'], ['osud', 'shořelo / uniklo']];
  $('gravUdaje').innerHTML = udaje.map(([id, p]) =>
    `<div><div class="popisek">${p}</div><div class="hodnota" id="grav_${id}">–</div></div>`).join('');
  const cislo = (n, d = 2) => n.toFixed(d).replace('.', ',');
  const sklon = n => n === 1 ? 'planetka' : n < 5 ? 'planetky' : 'planetek';

  function fyzika(dt) {
    const s = stred();
    for (const t of telesa) {
      // menší kroky = přesnější dráha i u rychlých průletů kolem hvězdy
      for (let i = 0; i < 4; i++) krok(t, dt / 4);
      const u = Math.atan2(t.y - s.y, t.x - s.x);
      if (t.uhel !== null) {
        let d = u - t.uhel;
        while (d > Math.PI) d -= 2 * Math.PI;
        while (d < -Math.PI) d += 2 * Math.PI;
        t.naskladano = (t.naskladano || 0) + d;
        t.obehy = Math.floor(Math.abs(t.naskladano) / (2 * Math.PI));
      }
      t.uhel = u;
      t.stopa.push({ x: t.x, y: t.y });
      if (t.stopa.length > 260) t.stopa.shift();
    }
    telesa = telesa.filter(t => {
      const r = Math.hypot(t.x - s.x, t.y - s.y);
      if (r < R_HVEZDA + 3) { vybuch(t.x, t.y, t.barva); pocty.shorelo++; return false; }
      if (r > 4000) { pocty.uniklo++; return false; }
      return true;
    });
    jiskry = jiskry.filter(j => {
      j.x += j.vx * dt; j.y += j.vy * dt; j.zivot -= dt * 1.6;
      return j.zivot > 0;
    });
  }

  function panel() {
    const t = telesa[telesa.length - 1];
    $('grav_telesa').textContent = telesa.length;
    $('grav_osud').textContent = pocty.shorelo + ' / ' + pocty.uniklo;
    if (!t) {
      ['obehy', 'perioda', 'vystrednost'].forEach(k => { $('grav_' + k).textContent = '–'; });
      return;
    }
    const el = elementy(t);
    $('grav_obehy').textContent = t.obehy;
    $('grav_perioda').textContent = el.vazane ? cislo(el.T, 1) + ' s' : 'uniká';
    $('grav_vystrednost').textContent = el.vazane ? cislo(el.e) : cislo(el.e) + ' (>1)';
  }

  /* Kam to poletí: dráha se dopočítá dopředu **stejným integrátorem**, jakým se
     pak opravdu poletí – co je vidět při míření, to se skutečně stane.
     Počítá se do prvního oběhu, do pádu do hvězdy nebo do úniku z plátna. */
  function predpoved(x, y, vx, vy) {
    const s = stred();
    const t = { x, y, vx, vy };
    const body = [{ x, y }];
    let osud = 'orbita', uhel = Math.atan2(y - s.y, x - s.x), obeh = 0;
    for (let i = 0; i < 1600; i++) {
      const r = krok(t, 1 / 120);
      if (i % 4 === 0) body.push({ x: t.x, y: t.y });
      if (r < R_HVEZDA + 3) { osud = 'pad'; break; }
      if (t.x < -400 || t.x > P.w() + 400 || t.y < -400 || t.y > P.h() + 400) { osud = 'unik'; break; }
      const u = Math.atan2(t.y - s.y, t.x - s.x);
      let d = u - uhel;
      while (d > Math.PI) d -= 2 * Math.PI;
      while (d < -Math.PI) d += 2 * Math.PI;
      obeh += d; uhel = u;
      if (Math.abs(obeh) > 2 * Math.PI) { osud = 'orbita'; break; }   // dráha se uzavřela
    }
    return { body, osud };
  }

  function sipka(ctx, x, y, dx, dy, barva, sila = 2) {
    const d = Math.hypot(dx, dy);
    if (d < 3) return;
    const ux = dx / d, uy = dy / d;
    ctx.strokeStyle = barva; ctx.fillStyle = barva; ctx.lineWidth = sila;
    ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + dx, y + dy); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x + dx, y + dy);
    ctx.lineTo(x + dx - ux * 7 - uy * 4, y + dy - uy * 7 + ux * 4);
    ctx.lineTo(x + dx - ux * 7 + uy * 4, y + dy - uy * 7 - ux * 4);
    ctx.closePath(); ctx.fill();
  }

  /* Gravitační pole: mřížka šipek k hvězdě, délka roste s 1/r² – přesně to,
     co planetku zatáčí. Bez toho vypadá pohyb jako kouzlo. */
  function poleGravitace(ctx, w, h, s) {
    const krokMrizky = 54;
    for (let x = krokMrizky / 2; x < w; x += krokMrizky) {
      for (let y = krokMrizky / 2; y < h; y += krokMrizky) {
        const dx = s.x - x, dy = s.y - y, r = Math.hypot(dx, dy);
        if (r < R_HVEZDA * 3) continue;
        const a = MU / (r * r);
        const delka = Math.min(26, Math.max(5, a * 0.045));
        ctx.globalAlpha = Math.min(0.5, 0.1 + delka / 60);
        sipka(ctx, x, y, dx / r * delka, dy / r * delka, '#6aa6fd', 1.4);
      }
    }
    ctx.globalAlpha = 1;
  }

  function kresli() {
    const { ctx } = P, w = P.w(), h = P.h(), s = stred();
    ctx.fillStyle = TEMA.svetlo ? '#0d1526' : '#0a0f1a';
    ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = '#ffffff';
    for (const z of hvezdicky) { ctx.globalAlpha = z.a; ctx.fillRect(z.x * w, z.y * h, 1.4, 1.4); }
    ctx.globalAlpha = 1;

    if (ukazGravitaci) poleGravitace(ctx, w, h, s);

    for (const t of telesa) {
      ctx.strokeStyle = t.barva; ctx.lineWidth = 1.6;
      ctx.beginPath();
      t.stopa.forEach((p, i) => {
        ctx.globalAlpha = 0.06 + 0.5 * (i / t.stopa.length);
        if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
      });
      ctx.stroke();
      ctx.globalAlpha = 1;
      ctx.fillStyle = t.barva;
      ctx.beginPath(); ctx.arc(t.x, t.y, 5, 0, 7); ctx.fill();

      // žlutá = gravitační síla (vždy k hvězdě), zelená = rychlost (kam letí teď)
      if (ukazGravitaci) {
        const a = zrychleni(t.x, t.y);
        const velikost = Math.min(46, Math.max(12, Math.hypot(a.ax, a.ay) * 0.05));
        const smer = Math.hypot(a.ax, a.ay) || 1;
        sipka(ctx, t.x, t.y, a.ax / smer * velikost, a.ay / smer * velikost, TEMA.warn);
        sipka(ctx, t.x, t.y, t.vx * 0.11, t.vy * 0.11, TEMA.ok);
      }
    }

    for (const j of jiskry) {
      ctx.globalAlpha = Math.max(j.zivot, 0);
      ctx.fillStyle = j.barva;
      ctx.beginPath(); ctx.arc(j.x, j.y, 2.2, 0, 7); ctx.fill();
    }
    ctx.globalAlpha = 1;

    const g = ctx.createRadialGradient(s.x, s.y, 2, s.x, s.y, R_HVEZDA * 3.4);
    g.addColorStop(0, '#fff6d5'); g.addColorStop(0.34, '#ffcf5c');
    g.addColorStop(1, 'rgba(255,180,60,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(s.x, s.y, R_HVEZDA * 3.4, 0, 7); ctx.fill();
    ctx.fillStyle = '#fff3c4';
    ctx.beginPath(); ctx.arc(s.x, s.y, R_HVEZDA, 0, 7); ctx.fill();

    if (mireni) {
      const vx = (mireni.x - mireni.mx) * 1.7, vy = (mireni.y - mireni.my) * 1.7;
      const rychlost = Math.hypot(vx, vy);

      // dopředu spočítaná dráha – barva rovnou říká, jak to dopadne
      const { body, osud } = predpoved(mireni.x, mireni.y, vx, vy);
      const barvy = { orbita: TEMA.ok, pad: TEMA.danger, unik: TEMA.warn };
      const popisky = { orbita: 'oběžná dráha', pad: 'spadne do hvězdy', unik: 'unikne do prázdna' };
      ctx.strokeStyle = barvy[osud]; ctx.lineWidth = 2; ctx.setLineDash([6, 5]);
      ctx.beginPath();
      body.forEach((b, i) => (i ? ctx.lineTo(b.x, b.y) : ctx.moveTo(b.x, b.y)));
      ctx.stroke();
      ctx.setLineDash([]);

      // prak: čára od místa startu k ukazateli a šipka počáteční rychlosti
      ctx.strokeStyle = TEMA['text-faint']; ctx.lineWidth = 1.4; ctx.setLineDash([3, 4]);
      ctx.beginPath(); ctx.moveTo(mireni.x, mireni.y); ctx.lineTo(mireni.mx, mireni.my); ctx.stroke();
      ctx.setLineDash([]);
      sipka(ctx, mireni.x, mireni.y, vx * 0.11, vy * 0.11, barvy[osud]);
      ctx.fillStyle = barvy[osud];
      ctx.beginPath(); ctx.arc(mireni.x, mireni.y, 5, 0, 7); ctx.fill();

      const kruhova = Math.sqrt(MU / Math.max(Math.hypot(mireni.x - s.x, mireni.y - s.y), 1));
      // popisek u ukazatele, ale vždy uvnitř plátna – při dlouhém tažení
      // (a se zachyceným ukazatelem) se míří i daleko za okrajem
      const lx = Math.min(Math.max(mireni.mx + 12, 10), w - 148);
      const ly = Math.min(Math.max(mireni.my - 10, 22), h - 26);
      ctx.font = '600 12px ' + getComputedStyle(document.body).fontFamily;
      ctx.fillStyle = barvy[osud];
      ctx.fillText(popisky[osud], lx, ly);
      ctx.font = '12px ' + getComputedStyle(document.body).fontFamily;
      ctx.fillStyle = TEMA['text-muted'];
      ctx.fillText(Math.round(rychlost / kruhova * 100) + ' % kruhové rychlosti', lx, ly + 16);
    }
  }

  const cedule = $('gravCedule');
  animuj(cv, dt => {
    if (bezi) fyzika(dt);
    kresli();
    panel();
    cedule.innerHTML = telesa.length
      ? '<b>' + telesa.length + '</b> ' + sklon(telesa.length) + ' na dráze'
      : '<b>Táhněte myší a pusťte</b> – dráha se ukáže dřív, než planetku pustíte.';
  });
}

/* ============================================================
   3. AERODYNAMICKÝ TUNEL
   Zkrácená verze obsah/vitr_tunel.html. Proudění kolem válce se počítá
   analyticky (potenciální obtékání), takže je vidět učebnicový jev:
   u boků překážky se proud zrychlí, před ní a za ní se zastaví.
   ============================================================ */
{
  const cv = $('tunelPlatno');
  const P = nastavPlatno(cv);
  const cast = [];
  let prekazka = { x: 0.42, y: 0.5, r: 42 };   // x, y v poměru k plátnu
  let tahnu = false;

  const sU = $('tunelV'), sR = $('tunelR'), sStopy = $('tunelStopy');
  const U = () => +sU.value;

  // Škála je zakotvená v rychlosti volného proudu (t = 0,5): ta má základní
  // modrou, zpomalený proud tmavne, zrychlený hoří do oranžova a červena.
  // Diverging škála přes bílý střed vypadala vybledle, protože většina plátna
  // je právě volný proud.
  // Na bílém papíře světlého režimu je stejná škála skoro neviditelná,
  // proto má vlastní, tmavší sadu.
  const STUPNE_TMA = [[0, [26, 42, 82]], [0.5, [106, 166, 253]], [0.75, [224, 166, 63]], [1, [224, 93, 61]]];
  const STUPNE_SVETLO = [[0, [150, 170, 200]], [0.5, [47, 111, 206]], [0.75, [200, 130, 20]], [1, [176, 38, 30]]];
  function barvaRychlosti(t) {
    const STUPNE = TEMA.svetlo ? STUPNE_SVETLO : STUPNE_TMA;
    for (let i = 1; i < STUPNE.length; i++) {
      if (t > STUPNE[i][0]) continue;
      const [t0, c0] = STUPNE[i - 1], [t1, c1] = STUPNE[i];
      const k = (t - t0) / (t1 - t0);
      return `rgb(${c0.map((v, j) => Math.round(v + (c1[j] - v) * k)).join(',')})`;
    }
    return TEMA.svetlo ? 'rgb(176,38,30)' : 'rgb(224,93,61)';
  }

  function nasypej() {
    cast.length = 0;
    for (let i = 0; i < 700; i++) cast.push({ x: Math.random(), y: Math.random(), v: 0 });
  }
  nasypej();

  // rychlostní pole potenciálního obtékání válce (v soustavě překážky)
  function pole(x, y, cx, cy, R, u) {
    const dx = x - cx, dy = y - cy, r2 = dx * dx + dy * dy;
    if (r2 < R * R) return { vx: 0, vy: 0, uvnitr: true };
    const k = R * R / (r2 * r2);
    return { vx: u * (1 - k * (dx * dx - dy * dy)), vy: -u * k * 2 * dx * dy, uvnitr: false };
  }

  cv.addEventListener('pointerdown', e => {
    tahnu = true;
    try { cv.setPointerCapture(e.pointerId); } catch { /* nevadí */ }
    posun(e);
  });
  cv.addEventListener('pointermove', e => { if (tahnu) posun(e); });
  cv.addEventListener('pointerup', () => { tahnu = false; });
  cv.addEventListener('pointercancel', () => { tahnu = false; });
  function posun(e) {
    const b = bod(cv, e);
    prekazka.x = Math.min(0.8, Math.max(0.15, b.x / P.w()));
    prekazka.y = Math.min(0.85, Math.max(0.15, b.y / P.h()));
  }
  sR.addEventListener('input', () => { prekazka.r = +sR.value; });

  animuj(cv, dt => {
    const { ctx } = P, w = P.w(), h = P.h();
    const cx = prekazka.x * w, cy = prekazka.y * h, R = prekazka.r, u = U();

    if (sStopy.checked) {
      ctx.fillStyle = TEMA['bg-input'];
      ctx.globalAlpha = 0.16;
      ctx.fillRect(0, 0, w, h);
      ctx.globalAlpha = 1;
    } else {
      ctx.fillStyle = TEMA['bg-input'];
      ctx.fillRect(0, 0, w, h);
    }

    let nejrychlejsi = 0;
    for (const c of cast) {
      const x = c.x * w, y = c.y * h;
      const p = pole(x, y, cx, cy, R, u);
      const v = Math.hypot(p.vx, p.vy);
      c.v = v;
      if (v > nejrychlejsi) nejrychlejsi = v;
      // částice uvnitř překážky nebo za pravým okrajem se vrací na začátek
      if (p.uvnitr || c.x > 1) { c.x = -0.02; c.y = Math.random(); continue; }
      c.x += p.vx * dt / w;
      c.y += p.vy * dt / h;
      if (c.y < 0 || c.y > 1) { c.x = -0.02; c.y = Math.random(); continue; }

      // Barva podle rychlosti rozvržená kolem rychlosti volného proudu:
      // modrá = pomaleji než vítr (stagnace před překážkou a za ní),
      // světlá = rychlost větru, červená = zrychlený proud u boků.
      // Přechod přes zelenou (běžný duhový přechod) by tenhle střed rozmazal.
      const t = Math.min(v / (2 * u), 1);
      ctx.fillStyle = barvaRychlosti(t);
      ctx.globalAlpha = 0.45 + 0.55 * t;
      ctx.fillRect(c.x * w, c.y * h, 2.4, 2.4);
    }
    ctx.globalAlpha = 1;

    ctx.fillStyle = TEMA.svetlo ? '#9aa4b0' : '#5c6672';
    ctx.strokeStyle = TEMA.text;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, 7); ctx.fill(); ctx.stroke();

    $('tunelCedule').innerHTML =
      'u boků až <b>' + Math.round(nejrychlejsi / u * 100) + ' %</b> rychlosti větru<br>'
      + '<span style="color:' + barvaRychlosti(0.1) + '">■</span> zpomaleno · '
      + '<span style="color:' + barvaRychlosti(0.5) + '">■</span> rychlost větru · '
      + '<span style="color:' + barvaRychlosti(1) + '">■</span> zrychleno';
  });
}
</script>
<script>
/* ============================================================
   2. PERIODICKÁ TABULKA
   Zkrácená verze obsah/periodic_table.html. Data prvků, barvy skupin
   i výpočet elektronové konfigurace (Madelungovo pravidlo s výjimkami)
   jsou převzaté odtud, aby se ukázka a plná verze nerozcházely.
   ============================================================ */
{
  const CATS={'alkalicke':['Alkalické kovy','#e74c3c'],'kovy-alk-zem':['Kovy alk. zemin','#e67e22'],'prechodne':['Přechodné kovy','#f1c40f'],'kovy':['Kovy','#27ae60'],'polokovy':['Polokovy','#1abc9c'],'nekovy':['Nekovy','#3498db'],'halogeny':['Halogeny','#9b59b6'],'vzacne':['Vzácné plyny','#e84393'],'lanthanoidy':['Lanthanoidy','#16a085'],'aktinoidy':['Aktinoidy','#8e44ad']};
  const EL=[
  [1,'H','Vodík',1,1,'nekovy',1.008],[2,'He','Helium',18,1,'vzacne',4.003],
  [3,'Li','Lithium',1,2,'alkalicke',6.94],[4,'Be','Beryllium',2,2,'kovy-alk-zem',9.012],[5,'B','Bor',13,2,'polokovy',10.81],[6,'C','Uhlík',14,2,'nekovy',12.011],[7,'N','Dusík',15,2,'nekovy',14.007],[8,'O','Kyslík',16,2,'nekovy',15.999],[9,'F','Fluor',17,2,'halogeny',18.998],[10,'Ne','Neon',18,2,'vzacne',20.18],
  [11,'Na','Sodík',1,3,'alkalicke',22.99],[12,'Mg','Hořčík',2,3,'kovy-alk-zem',24.305],[13,'Al','Hliník',13,3,'kovy',26.982],[14,'Si','Křemík',14,3,'polokovy',28.085],[15,'P','Fosfor',15,3,'nekovy',30.974],[16,'S','Síra',16,3,'nekovy',32.06],[17,'Cl','Chlor',17,3,'halogeny',35.45],[18,'Ar','Argon',18,3,'vzacne',39.948],
  [19,'K','Draslík',1,4,'alkalicke',39.098],[20,'Ca','Vápník',2,4,'kovy-alk-zem',40.078],[21,'Sc','Skandium',3,4,'prechodne',44.956],[22,'Ti','Titan',4,4,'prechodne',47.867],[23,'V','Vanad',5,4,'prechodne',50.942],[24,'Cr','Chrom',6,4,'prechodne',51.996],[25,'Mn','Mangan',7,4,'prechodne',54.938],[26,'Fe','Železo',8,4,'prechodne',55.845],[27,'Co','Kobalt',9,4,'prechodne',58.933],[28,'Ni','Nikl',10,4,'prechodne',58.693],[29,'Cu','Měď',11,4,'prechodne',63.546],[30,'Zn','Zinek',12,4,'prechodne',65.38],[31,'Ga','Gallium',13,4,'kovy',69.723],[32,'Ge','Germanium',14,4,'polokovy',72.63],[33,'As','Arsen',15,4,'polokovy',74.922],[34,'Se','Selen',16,4,'nekovy',78.971],[35,'Br','Brom',17,4,'halogeny',79.904],[36,'Kr','Krypton',18,4,'vzacne',83.798],
  [37,'Rb','Rubidium',1,5,'alkalicke',85.468],[38,'Sr','Stroncium',2,5,'kovy-alk-zem',87.62],[39,'Y','Yttrium',3,5,'prechodne',88.906],[40,'Zr','Zirkonium',4,5,'prechodne',91.224],[41,'Nb','Niob',5,5,'prechodne',92.906],[42,'Mo','Molybden',6,5,'prechodne',95.95],[43,'Tc','Technecium',7,5,'prechodne',98],[44,'Ru','Ruthenium',8,5,'prechodne',101.07],[45,'Rh','Rhodium',9,5,'prechodne',102.91],[46,'Pd','Palladium',10,5,'prechodne',106.42],[47,'Ag','Stříbro',11,5,'prechodne',107.87],[48,'Cd','Kadmium',12,5,'prechodne',112.41],[49,'In','Indium',13,5,'kovy',114.82],[50,'Sn','Cín',14,5,'kovy',118.71],[51,'Sb','Antimon',15,5,'polokovy',121.76],[52,'Te','Tellur',16,5,'polokovy',127.6],[53,'I','Jod',17,5,'halogeny',126.9],[54,'Xe','Xenon',18,5,'vzacne',131.29],
  [55,'Cs','Cesium',1,6,'alkalicke',132.91],[56,'Ba','Baryum',2,6,'kovy-alk-zem',137.33],[57,'La','Lanthan',3,6,'lanthanoidy',138.91],[72,'Hf','Hafnium',4,6,'prechodne',178.49],[73,'Ta','Tantal',5,6,'prechodne',180.95],[74,'W','Wolfram',6,6,'prechodne',183.84],[75,'Re','Rhenium',7,6,'prechodne',186.21],[76,'Os','Osmium',8,6,'prechodne',190.23],[77,'Ir','Iridium',9,6,'prechodne',192.22],[78,'Pt','Platina',10,6,'prechodne',195.08],[79,'Au','Zlato',11,6,'prechodne',196.97],[80,'Hg','Rtuť',12,6,'prechodne',200.59],[81,'Tl','Thallium',13,6,'kovy',204.38],[82,'Pb','Olovo',14,6,'kovy',207.2],[83,'Bi','Bismut',15,6,'kovy',208.98],[84,'Po','Polonium',16,6,'kovy',209],[85,'At','Astat',17,6,'halogeny',210],[86,'Rn','Radon',18,6,'vzacne',222],
  [87,'Fr','Francium',1,7,'alkalicke',223],[88,'Ra','Radium',2,7,'kovy-alk-zem',226],[89,'Ac','Aktinium',3,7,'aktinoidy',227],[104,'Rf','Rutherfordium',4,7,'prechodne',267],[105,'Db','Dubnium',5,7,'prechodne',268],[106,'Sg','Seaborgium',6,7,'prechodne',269],[107,'Bh','Bohrium',7,7,'prechodne',270],[108,'Hs','Hassium',8,7,'prechodne',269],[109,'Mt','Meitnerium',9,7,'prechodne',278],[110,'Ds','Darmstadtium',10,7,'prechodne',281],[111,'Rg','Roentgenium',11,7,'prechodne',282],[112,'Cn','Kopernicium',12,7,'prechodne',285],[113,'Nh','Nihonium',13,7,'kovy',286],[114,'Fl','Flerovium',14,7,'kovy',289],[115,'Mc','Moscovium',15,7,'kovy',290],[116,'Lv','Livermorium',16,7,'kovy',293],[117,'Ts','Tennessin',17,7,'halogeny',294],[118,'Og','Oganesson',18,7,'vzacne',294],
  [58,'Ce','Cer',4,9,'lanthanoidy',140.12],[59,'Pr','Praseodym',5,9,'lanthanoidy',140.91],[60,'Nd','Neodym',6,9,'lanthanoidy',144.24],[61,'Pm','Promethium',7,9,'lanthanoidy',145],[62,'Sm','Samarium',8,9,'lanthanoidy',150.36],[63,'Eu','Europium',9,9,'lanthanoidy',151.96],[64,'Gd','Gadolinium',10,9,'lanthanoidy',157.25],[65,'Tb','Terbium',11,9,'lanthanoidy',158.93],[66,'Dy','Dysprosium',12,9,'lanthanoidy',162.5],[67,'Ho','Holmium',13,9,'lanthanoidy',164.93],[68,'Er','Erbium',14,9,'lanthanoidy',167.26],[69,'Tm','Thulium',15,9,'lanthanoidy',168.93],[70,'Yb','Ytterbium',16,9,'lanthanoidy',173.05],[71,'Lu','Lutecium',17,9,'lanthanoidy',174.97],
  [90,'Th','Thorium',4,10,'aktinoidy',232.04],[91,'Pa','Protaktinium',5,10,'aktinoidy',231.04],[92,'U','Uran',6,10,'aktinoidy',238.03],[93,'Np','Neptunium',7,10,'aktinoidy',237],[94,'Pu','Plutonium',8,10,'aktinoidy',244],[95,'Am','Americium',9,10,'aktinoidy',243],[96,'Cm','Curium',10,10,'aktinoidy',247],[97,'Bk','Berkelium',11,10,'aktinoidy',247],[98,'Cf','Kalifornium',12,10,'aktinoidy',251],[99,'Es','Einsteinium',13,10,'aktinoidy',252],[100,'Fm','Fermium',14,10,'aktinoidy',257],[101,'Md','Mendelevium',15,10,'aktinoidy',258],[102,'No','Nobelium',16,10,'aktinoidy',259],[103,'Lr','Lawrencium',17,10,'aktinoidy',262]
  ];
  const PLYNY=new Set([1,2,7,8,9,10,17,18,36,54,86]), KAPALNE=new Set([35,80]);
  const skupenstvi=z=>PLYNY.has(z)?'plynné':KAPALNE.has(z)?'kapalné':z>=104?'neznámé (syntetický)':'pevné';
  const ORDER=['1s','2s','2p','3s','3p','4s','3d','4p','5s','4d','5p','6s','4f','5d','6p','7s','5f','6d','7p'];
  const CAP={s:2,p:6,d:10,f:14};
  const VYJIMKY={24:{'4s':1,'3d':5},29:{'4s':1,'3d':10},41:{'5s':1,'4d':4},42:{'5s':1,'4d':5},44:{'5s':1,'4d':7},45:{'5s':1,'4d':8},46:{'5s':0,'4d':10},47:{'5s':1,'4d':10},57:{'4f':0,'5d':1},58:{'4f':1,'5d':1},64:{'4f':7,'5d':1},78:{'6s':1,'5d':9},79:{'6s':1,'5d':10},89:{'5f':0,'6d':1},90:{'5f':0,'6d':2},91:{'5f':2,'6d':1},92:{'5f':3,'6d':1},93:{'5f':4,'6d':1},96:{'5f':7,'6d':1},103:{'6d':0,'7p':1}};
  function obsazeni(z){
    let zb=z; const occ={};
    for(const o of ORDER){ if(zb<=0)break; const n=Math.min(CAP[o[1]],zb); occ[o]=n; zb-=n; }
    const v=VYJIMKY[z]; if(v)for(const k in v)occ[k]=v[k];
    for(const k in occ)if(!occ[k])delete occ[k];
    return occ;
  }
  const JADRA=[[86,'Rn',['1s','2s','2p','3s','3p','4s','3d','4p','5s','4d','5p','6s','4f','5d','6p']],
               [54,'Xe',['1s','2s','2p','3s','3p','4s','3d','4p','5s','4d','5p']],
               [36,'Kr',['1s','2s','2p','3s','3p','4s','3d','4p']],
               [18,'Ar',['1s','2s','2p','3s','3p']],
               [10,'Ne',['1s','2s','2p']],
               [2,'He',['1s']]];
  function konfigurace(z){
    const occ=obsazeni(z);
    for(const[cz,sym,orbs]of JADRA){
      if(z>cz&&orbs.every(o=>occ[o]===CAP[o[1]])){
        const zbytek=ORDER.filter(o=>!orbs.includes(o)&&occ[o]).map(o=>o+'<sup>'+occ[o]+'</sup>').join(' ');
        return '['+sym+'] '+zbytek;
      }
    }
    return ORDER.filter(o=>occ[o]).map(o=>o+'<sup>'+occ[o]+'</sup>').join(' ');
  }
  function slupky(z){
    const occ=obsazeni(z), s=[0,0,0,0,0,0,0];
    for(const o in occ)s[+o[0]-1]+=occ[o];
    return s.filter((_,i)=>s[i]>0);
  }

  const mrizka = $('ptMrizka'), detail = $('ptDetail'), legenda = $('ptLegenda');
  let filtr = null, hledane = '', vybrany = 26;   // železo jako první pohled

  // řádek 8 je mezera mezi hlavní tabulkou a lanthanoidy/aktinoidy
  const mezera = document.createElement('div');
  mezera.className = 'pt-mezera';
  mezera.style.gridRow = 8;

  EL.forEach(e => {
    const [z, zn, nazev, skupina, perioda, kat] = e;
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'pt-prvek';
    b.style.gridColumn = skupina;
    b.style.gridRow = perioda;
    b.style.background = CATS[kat][1];
    b.title = nazev;
    b.innerHTML = `<span class="z">${z}</span><span class="zn">${zn}</span>`
      + `<span class="nz">${nazev}</span>`;
    b.addEventListener('click', () => ukazPrvek(z));
    e.prvek = b;
    mrizka.appendChild(b);
  });
  mrizka.appendChild(mezera);

  legenda.innerHTML = Object.entries(CATS).map(([k, [n, c]]) =>
    `<button type="button" data-kat="${k}"><i style="background:${c}"></i>${n}</button>`).join('');
  legenda.addEventListener('click', ev => {
    const b = ev.target.closest('button');
    if (!b) return;
    filtr = filtr === b.dataset.kat ? null : b.dataset.kat;
    legenda.querySelectorAll('button').forEach(x => x.classList.toggle('aktivni', x.dataset.kat === filtr));
    prekresliFiltr();
  });

  $('ptHledat').addEventListener('input', ev => {
    hledane = ev.target.value.trim().toLowerCase();
    prekresliFiltr();
    // jediná shoda se rovnou otevře – hledání tak nahrazuje klikání
    const shody = EL.filter(vyhovuje);
    if (hledane && shody.length === 1) ukazPrvek(shody[0][0]);
  });

  $('ptNahodny').addEventListener('click', () => ukazPrvek(EL[Math.floor(Math.random() * EL.length)][0]));

  function vyhovuje(e) {
    const [z, zn, nazev, , , kat] = e;
    if (filtr && kat !== filtr) return false;
    if (!hledane) return true;
    return String(z) === hledane || zn.toLowerCase() === hledane
      || nazev.toLowerCase().startsWith(hledane) || zn.toLowerCase().startsWith(hledane);
  }

  function prekresliFiltr() {
    const filtruje = filtr || hledane;
    EL.forEach(e => {
      e.prvek.classList.toggle('ztlumeny', filtruje && !vyhovuje(e));
      e.prvek.classList.toggle('vybrany', e[0] === vybrany);
    });
  }

  /* ---- detail s Bohrovým modelem ---- */
  detail.innerHTML = `
    <div class="hlava"><div class="znak" id="ptZnak"></div>
      <div><h3 id="ptNazev"></h3><div class="kat" id="ptKat"></div></div></div>
    <div class="radek"><span>Protonové číslo</span><b id="ptZ"></b></div>
    <div class="radek"><span>Atomová hmotnost</span><b id="ptM"></b></div>
    <div class="radek"><span>Skupina / perioda</span><b id="ptSP"></b></div>
    <div class="radek"><span>Skupenství (20 °C)</span><b id="ptSk"></b></div>
    <div class="konf" id="ptKonf"></div>
    <canvas id="ptBohr"></canvas>
    <div class="konf" id="ptSlupky"></div>`;

  const B = nastavPlatno($('ptBohr'));
  let bohr = { slupky: [], barva: '#6aa6fd' };

  function ukazPrvek(z) {
    const e = EL.find(x => x[0] === z);
    if (!e) return;
    vybrany = z;
    const [num, zn, nazev, skupina, perioda, kat, hmotnost] = e;
    $('ptZnak').textContent = zn;
    $('ptZnak').style.color = CATS[kat][1];
    $('ptNazev').textContent = nazev;
    $('ptKat').textContent = CATS[kat][0];
    $('ptZ').textContent = num;
    $('ptM').textContent = String(hmotnost).replace('.', ',');
    $('ptSP').textContent = (skupina <= 18 && perioda <= 7 ? skupina : '—') + ' / '
      + (perioda <= 7 ? perioda : num < 89 ? '6' : '7');
    $('ptSk').textContent = skupenstvi(num);
    $('ptKonf').innerHTML = 'Konfigurace: ' + konfigurace(num);
    const s = slupky(num);
    $('ptSlupky').textContent = 'Elektrony ve slupkách: ' + s.join(' · ');
    bohr = { slupky: s, barva: CATS[kat][1] };
    prekresliFiltr();
  }

  animuj($('ptBohr'), () => {
    const { ctx } = B, w = B.w(), h = B.h();
    ctx.clearRect(0, 0, w, h);
    const cx = w / 2, cy = h / 2;
    const maxR = Math.min(w, h) / 2 - 8;
    const n = bohr.slupky.length;
    const t = performance.now() / 1000;

    ctx.fillStyle = bohr.barva;
    ctx.beginPath(); ctx.arc(cx, cy, 9, 0, 7); ctx.fill();

    bohr.slupky.forEach((pocet, i) => {
      const r = maxR * (i + 1) / n;
      ctx.strokeStyle = TEMA.border;
      ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(cx, cy, r, 0, 7); ctx.stroke();
      // vnější slupky obíhají pomaleji – opticky odpovídá skutečnosti
      const rychlost = 0.9 / (i + 1);
      for (let k = 0; k < pocet; k++) {
        const u = t * rychlost + k * 2 * Math.PI / pocet;
        ctx.fillStyle = TEMA.accent;
        ctx.beginPath();
        ctx.arc(cx + Math.cos(u) * r, cy + Math.sin(u) * r, 2.6, 0, 7);
        ctx.fill();
      }
    });
  });

  ukazPrvek(vybrany);
}

/* ============================================================
   4. STAVBA BUŇKY
   Zkrácená verze obsah/bunka.html – jen atlas, a z něj jen rostlinná buňka
   (plná verze má i živočišnou, srovnávací tabulku, řetězec spolupráce a kvíz).
   Model, popisky částí i jejich obrysy jsou převzaté z plné verze beze změny,
   aby ukázka neříkala něco jiného; stejné jsou i barvy zvýraznění – obrázek
   leží na bílém podkladu, takže drží nezávisle na motivu stránky.

   Kvůli soběstačnosti stránky je model vložený rovnou v souboru jako data URI:
   Prirodopis/bunka_rostlinna.png zmenšený na 96 barev a uložený jako
   bezztrátový WebP (145 kB base64 místo 256 kB z původního PNG; vizuálně
   shodné). Při aktualizaci obrázku v bunka.html je potřeba převést znovu:
     magick Prirodopis/bunka_rostlinna.png -dither None -colors 96 /tmp/b.png
     cwebp -lossless -z 9 -m 6 /tmp/b.png -o /tmp/b.webp && base64 -w0 /tmp/b.webp
   ============================================================ */
{
  const ORGANELY={
    "membrana": {
      "n": "Buněčná membrána",
      "d": "Řídí výměnu látek mezi buňkou a okolím.",
      "stavba": "Tenká pružná hranice buňky. U rostlin leží pod buněčnou stěnou.",
      "analogie": "Výběrová brána",
      "pozor": "Propouští některé látky snáze než jiné; buňka také využívá přenašeče a energii.",
      "group": "obal"
    },
    "cytoplazma": {
      "n": "Cytoplazma",
