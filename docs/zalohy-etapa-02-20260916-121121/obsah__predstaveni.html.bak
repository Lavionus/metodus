      <circle class="organ" data-o="ribozom" cx="145" cy="423" r="8"/>
      <circle class="organ" data-o="ribozom" cx="710" cy="621" r="8"/>
      <circle class="organ" data-o="ribozom" cx="79" cy="428" r="8"/>
