      <circle class="organ" data-o="ribozom" cx="698" cy="436" r="8"/>
    </svg>
  </div>`;


  const CASTI = ['stena','membrana','cytoplazma','vakuola','chloroplast','jadro','jaderko','er','ribozom','golgi','mitochondrie','vezikula'];
  const stage = $('bunkaStage'), info = $('bunkaInfo'), chipy = $('bunkaChipy'),
        popisek = $('bunkaPopisek'), stav = $('bunkaStav'), ukazatel = $('bunkaUkazatel');
  const SKUPINY = { obal: 'Hranice a ochrana', zaklad: 'Základní stavba', vyroba: 'Výroba a doprava',
                    energie: 'Přeměny energie', sklad: 'Uchovávání a rozklad' };
  const videne = new Set();

  function ukaz(klic) {
    videne.add(klic);
    const o = ORGANELY[klic];
    info.innerHTML = `<p class="skupina">${SKUPINY[o.group]}</p><h3>${o.n}</h3>
      <p class="uvod">${o.d}</p>
      <dl><dt>Jak vypadá a kde ji najdeš</dt><dd>${o.stavba}</dd>
          <dt>Pomůcka k zapamatování</dt><dd>${o.analogie} (zjednodušené přirovnání).</dd></dl>
      <p class="pozor">${o.pozor}</p>`;
    stage.querySelectorAll('.organ').forEach(el => el.classList.toggle('vybrany', el.dataset.o === klic));
    chipy.querySelectorAll('button').forEach(b => {
      b.classList.toggle('vybrany', b.dataset.o === klic);
      b.classList.toggle('videny', videne.has(b.dataset.o));
    });
    stav.textContent = `Prohlédnuto ${videne.size} z ${CASTI.length} částí`;
    ukazatel.value = videne.size;
  }

  stage.innerHTML = PLANT;
  popisek.textContent = 'Model dospělé buňky ze zelené části rostliny.';
  chipy.innerHTML = CASTI.map(k =>
    `<button type="button" data-o="${k}">${ORGANELY[k].n}</button>`).join('');
  ukazatel.max = CASTI.length;

  // klávesnice: Tab projde části, Enter/mezera otevře popis (jako v plné verzi)
  const prvni = new Set();
  stage.querySelectorAll('.organ').forEach(el => {
    const k = el.dataset.o;
    el.setAttribute('role', 'button');
    el.setAttribute('tabindex', prvni.has(k) ? '-1' : '0');
    prvni.add(k);
    el.setAttribute('aria-label', ORGANELY[k].n);
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); ukaz(k); }
    });
  });

  stage.addEventListener('click', ev => {
    const el = ev.target.closest('.organ');
    if (el) ukaz(el.dataset.o);
  });
  chipy.addEventListener('click', ev => {
    const b = ev.target.closest('button');
    if (b) ukaz(b.dataset.o);
  });

  ukaz('jadro');
}

/* ============================================================
   5. KVADRATICKÁ FUNKCE
   Zkrácená verze obsah/grafy_funkci.html – jen parabola, zato s vrcholem,
   kořeny a diskriminantem, které se přepočítají při každém pohybu jezdce.
   ============================================================ */
{
  const cv = $('grafPlatno');
  const P = nastavPlatno(cv);
  const sA = $('grafA'), sB = $('grafB'), sC = $('grafC');
  const cislo = n => (Math.round(n * 100) / 100).toString().replace('.', ',').replace('-', '\u2212');

  const koef = () => ({ a: +sA.value / 10, b: +sB.value / 10, c: +sC.value / 10 });

  function vzorec({ a, b, c }) {
    const cleny = [[a, 'x²', 'a'], [b, 'x', 'b'], [c, '', 'c']]
      .filter(([h]) => h)
      .map(([h, x, tr]) => {
        const abs = Math.abs(h);
        const cis = (abs === 1 && x) ? '' : cislo(abs);   // 1x² se píše jako x²
        return { zaporny: h < 0, html: `<span class="${tr}">${cis}${x}</span>` };
      });
    if (!cleny.length) return 'y = 0';
    return 'y = ' + cleny.map((c, i) =>
      (i === 0 ? (c.zaporny ? '−' : '') : (c.zaporny ? ' − ' : ' + ')) + c.html).join('');
  }

  function kresli() {
    const { a, b, c } = koef();
    const { ctx } = P, w = P.w(), h = P.h();
    // Jednotka je na obou osách stejná, jinak by se parabola deformovala.
    // Když vrchol vyjede z plátna (velké c nebo malé a), obraz se za ním
    // svisle posune – jinak by jezdec „nic nedělal“, protože klíčové místo
    // grafu leží mimo výřez.
    const jed = Math.min(w / 16, h / 11);
    const pulY = (h / 2) / jed;
    let posunY = 0;
    if (a) {
      const vy = c - b * b / (4 * a);
      if (Math.abs(vy) > pulY * 0.8) posunY = vy - Math.sign(vy) * pulY * 0.6;
    }
    const px = x => w / 2 + x * jed, py = y => h / 2 - (y - posunY) * jed;
    const odX = Math.ceil(-w / 2 / jed), doX = Math.floor(w / 2 / jed);
    const odY = Math.ceil(posunY - pulY), doY = Math.floor(posunY + pulY);

    ctx.fillStyle = TEMA['bg-input'];
    ctx.fillRect(0, 0, w, h);

    ctx.strokeStyle = TEMA.border;
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (let x = odX; x <= doX; x++) { ctx.moveTo(px(x), 0); ctx.lineTo(px(x), h); }
    for (let y = odY; y <= doY; y++) { ctx.moveTo(0, py(y)); ctx.lineTo(w, py(y)); }
    ctx.stroke();

    ctx.strokeStyle = TEMA['text-faint'];
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(0, py(0)); ctx.lineTo(w, py(0));
    ctx.moveTo(px(0), 0); ctx.lineTo(px(0), h);
    ctx.stroke();

    // čísla na osách – bez nich se z grafu nedá nic odečíst
    ctx.fillStyle = TEMA['text-faint'];
    ctx.font = '11px ' + getComputedStyle(document.body).fontFamily;
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (let x = odX; x <= doX; x++) {
      if (!x || px(x) < 12 || px(x) > w - 12) continue;
      ctx.fillText(x, px(x), Math.min(Math.max(py(0) + 4, 4), h - 14));
    }
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (let y = odY; y <= doY; y++) {
      if (!y || py(y) < 10 || py(y) > h - 10) continue;
      ctx.fillText(y, Math.max(px(0) - 5, 18), py(y));
    }
    ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';

    ctx.strokeStyle = TEMA.accent;
    ctx.lineWidth = 2.6;
    ctx.beginPath();
    for (let i = 0; i <= w; i++) {
      const x = (i - w / 2) / jed, y = a * x * x + b * x + c;
      const Y = py(y);
      if (i === 0) ctx.moveTo(i, Y); else ctx.lineTo(i, Y);
    }
    ctx.stroke();

    const fakta = [];
    if (a) {
      const vx = -b / (2 * a), vy = a * vx * vx + b * vx + c;
      ctx.fillStyle = TEMA.warn;
      ctx.beginPath(); ctx.arc(px(vx), py(vy), 5, 0, 7); ctx.fill();
      fakta.push(`Vrchol <b>[${cislo(vx)}; ${cislo(vy)}]</b>`);
      const D = b * b - 4 * a * c;
      fakta.push(`Diskriminant <b>${cislo(D)}</b>`);
      if (D > 0) {
        const koreny = [(-b - Math.sqrt(D)) / (2 * a), (-b + Math.sqrt(D)) / (2 * a)].sort((p, q) => p - q);
        const [x1, x2] = koreny;
        koreny.forEach(x => {
          ctx.fillStyle = TEMA.ok;
          ctx.beginPath(); ctx.arc(px(x), py(0), 5, 0, 7); ctx.fill();
        });
        fakta.push(`Kořeny <b>${cislo(x1)}</b> a <b>${cislo(x2)}</b>`);
      } else if (D === 0) {
        ctx.fillStyle = TEMA.ok;
        ctx.beginPath(); ctx.arc(px(-b / (2 * a)), py(0), 5, 0, 7); ctx.fill();
        fakta.push('Jeden dvojnásobný kořen – parabola se osy jen dotkne');
      } else {
        fakta.push('Žádný reálný kořen – parabola osu x neprotne');
      }
      fakta.push(a > 0 ? 'Parabola je otevřená nahoru (minimum ve vrcholu)'
                       : 'Parabola je otevřená dolů (maximum ve vrcholu)');
    } else {
      fakta.push('Při <b>a = 0</b> to už není kvadratická funkce – zbyla přímka.');
    }

    $('grafVzorec').innerHTML = vzorec({ a, b, c });
    $('grafFakta').innerHTML = fakta.join(' · ');
  }

  [sA, sB, sC].forEach(s => s.addEventListener('input', kresli));
  $('grafReset').addEventListener('click', () => {
    sA.value = 10; sB.value = 0; sC.value = 0;
    kresli();
  });
  new ResizeObserver(kresli).observe(cv);
  kresli();
}

