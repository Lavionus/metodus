  const SYN={easy:[['radost','veselí'],['smutek','žal'],['rychlý','svižný'],['statečný','odvážný'],['krásný','nádherný'],['chytrý','bystrý'],['velký','obrovský'],['malý','drobný'],['silný','mohutný'],['klidný','tichý'],['unavený','vyčerpaný'],['bohatý','zámožný']],
  medium:[['dům','stavení'],['pes','hafan'],['učitel','kantor'],['říci','pravit'],['jít','kráčet'],['dívat se','hledět'],['práce','dřina'],['strach','obava'],['lež','nepravda'],['cesta','stezka'],['zvíře','živočich'],['nemocný','chorý']],
  hard:[['okamžitě','ihned'],['zřejmě','patrně'],['podivný','zvláštní'],['nesnadný','obtížný'],['pochybovat','váhat'],['zdůraznit','vyzdvihnout'],['skromný','nenáročný'],['pečlivý','svědomitý'],['vzácný','ojedinělý'],['přemluvit','přesvědčit'],['výstižný','trefný'],['lhostejný','netečný']]};
  const ANT={easy:[['velký','malý'],['den','noc'],['teplo','zima'],['začátek','konec'],['radost','smutek'],['mladý','starý'],['rychlý','pomalý'],['vysoký','nízký'],['plný','prázdný'],['čistý','špinavý'],['světlo','tma'],['tvrdý','měkký']],
  medium:[['pravda','lež'],['přítel','nepřítel'],['bohatý','chudý'],['hluboký','mělký'],['ostrý','tupý'],['sladký','hořký'],['odvaha','strach'],['užitečný','zbytečný'],['veselý','smutný'],['blízko','daleko'],['vpřed','vzad'],['láska','nenávist']],
  hard:[['skromný','domýšlivý'],['štědrý','lakomý'],['pilný','líný'],['ochotný','neochotný'],['jistota','nejistota'],['přijmout','odmítnout'],['pochválit','pokárat'],['zvětšit','zmenšit'],['souhlas','nesouhlas'],['klidný','rozčilený'],['úspěch','neúspěch'],['vhodný','nevhodný']]};
  const ZVIRATA={
  easy:[['pes','savec'],['kočka','savec'],['kráva','savec'],['kapr','ryba'],['štika','ryba'],['holub','pták'],['vrabec','pták'],['orel','pták'],['skokan zelený','obojživelník'],['ještěrka','plaz'],['moucha','hmyz'],['mravenec','hmyz']],
  medium:[['netopýr','savec'],['delfín','savec'],['tučňák','pták'],['čáp','pták'],['mlok','obojživelník'],['zmije','plaz'],['želva','plaz'],['pstruh','ryba'],['včela','hmyz'],['pavouk','pavoukovci'],['rak','korýši'],['hlemýžď','měkkýši']],
  hard:[['velryba','savec'],['ptakopysk','savec'],['žralok','ryba'],['krokodýl','plaz'],['čolek','obojživelník'],['klíště','pavoukovci'],['krab','korýši'],['chobotnice','měkkýši'],['škeble','měkkýši'],['žížala','kroužkovci'],['medúza','žahavci'],['korál','žahavci']]};
  const VELICINY={
  easy:[['dráha','s','m','metr'],['čas','t','s','sekunda'],['hmotnost','m','kg','kilogram'],['objem','V','m³','metr krychlový'],['síla','F','N','newton'],['teplota','t','°C','stupeň Celsia']],
  medium:[['rychlost','v','m/s','metr za sekundu'],['hustota','ρ','kg/m³','kilogram na metr krychlový'],['tlak','p','Pa','pascal'],['práce','W','J','joule'],['výkon','P','W','watt'],['energie','E','J','joule']],
  hard:[['elektrický proud','I','A','ampér'],['elektrické napětí','U','V','volt'],['elektrický odpor','R','Ω','ohm'],['frekvence','f','Hz','hertz'],['elektrický náboj','Q','C','coulomb'],['teplo','Q','J','joule']]};

  const LV = { easy: 0, medium: 1, hard: 2 };
  const znamenko = n => (n < 0 ? '− ' + (-n) : '+ ' + n);
  const desetinne = n => String(Math.round(n * 100) / 100).replace('.', ',');

  /* Generátor: r = ročníky, t = název, instr = pokyn nad úlohami,
     gen(d, R) => { q: zadání, a: řešení } */
  const G = {
    scitani: { r: [1, 2, 3, 4, 5], t: '🔢 Sčítání a odčítání', instr: 'Vypočítej.', gen(d, R) {
      const max = [20, 100, 1000][LV[d]], op = R.chance(0.5) ? '+' : '−';
      let a = R.int(1, max), b = R.int(1, max);
      if (op === '−' && b > a) [a, b] = [b, a];
      return { q: `${a} ${op} ${b} =`, a: String(op === '+' ? a + b : a - b) };
    } },
    nasobilka: { r: [2, 3, 4, 5], t: '🔢 Malá násobilka', instr: 'Vypočítej zpaměti.', gen(d, R) {
      const [od, do_] = [[2, 5], [2, 10], [6, 12]][LV[d]];
      const a = R.int(od, do_), b = R.int(od, do_);
      return { q: `${a} · ${b} =`, a: String(a * b) };
    } },
    deleni: { r: [3, 4, 5, 6], t: '🔢 Dělení se zbytkem', instr: 'Vypočítej, uveď i zbytek.', gen(d, R) {
      const del = R.int(2, [5, 9, 12][LV[d]]);
      const a = R.int(del + 1, [40, 100, 300][LV[d]]);
      return { q: `${a} : ${del} =`, a: `${Math.floor(a / del)} zb. ${a % del}` };
    } },
    poradi: { r: [4, 5, 6, 7], t: '🔢 Pořadí operací', instr: 'Dodrž pořadí operací.', gen(d, R) {
      if (LV[d] === 0) { const a = R.int(2, 10), b = R.int(2, 9), c = R.int(2, 9); return { q: `${a} + ${b} · ${c} =`, a: String(a + b * c) }; }
      if (LV[d] === 1) { const a = R.int(2, 12), b = R.int(2, 12), c = R.int(2, 9); return { q: `(${a} + ${b}) · ${c} =`, a: String((a + b) * c) }; }
      const c = R.int(2, 9), q = R.int(2, 12), a = R.int(2, 15), b = R.int(2, 15);
      return { q: `${a} + ${c * q} : ${c} − ${b} =`, a: String(a + q - b) };
    } },
    zaokrouhleni: { r: [4, 5, 6, 7], t: '🔢 Zaokrouhlování', instr: 'Zaokrouhli podle zadání.', gen(d, R) {
      const lvl = LV[d], jed = [10, 100, 1000][lvl], nazev = ['desítky', 'stovky', 'tisíce'][lvl];
      const n = R.int(jed, jed * [9, 99, 99][lvl]);
      return { q: `Zaokrouhli na ${nazev}: ${n} =`, a: String(Math.round(n / jed) * jed) };
    } },
    procenta: { r: [6, 7, 8, 9], t: '🔢 Procenta z čísla', instr: 'Vypočítej.', gen(d, R) {
      const p = R.pick([[10, 25, 50], [5, 20, 75], [12, 35, 65]][LV[d]]);
      const zaklad = R.int(2, [20, 40, 80][LV[d]]) * 10;
      return { q: `${p} % z ${zaklad} =`, a: desetinne(zaklad * p / 100) };
    } },
    rovnice: { r: [7, 8, 9], t: '🔢 Lineární rovnice', instr: 'Vyřeš rovnici, zapiš i zkoušku.', gen(d, R) {
      const x = R.int(1, [8, 12, 20][LV[d]]), a = R.int(2, [5, 9, 12][LV[d]]), b = R.int(1, 20);
      if (LV[d] < 2) return { q: `${a}x + ${b} = ${a * x + b}`, a: `x = ${x}` };
      // těžká úroveň: neznámá na obou stranách; pravá strana se dopočítá tak,
      // aby řešením bylo právě x (a smí vyjít i záporná – proto se sází se znaménkem)
      const c = R.int(1, a - 1 > 0 ? a - 1 : 1) + (a === 1 ? 1 : 0);
      const prava = (a - c) * x + b;
      return { q: `${a}x + ${b} = ${c}x ${znamenko(prava)}`, a: `x = ${x}` };
    } },
    prevody: { r: [4, 5, 6, 7, 8, 9], t: '🔢 Převody jednotek', instr: 'Doplň chybějící údaj.', gen(d, R) {
      const rady = [[['m', 'cm', 100], ['kg', 'g', 1000], ['h', 'min', 60]],
                    [['km', 'm', 1000], ['l', 'ml', 1000], ['min', 's', 60]],
                    [['km²', 'ha', 100], ['t', 'kg', 1000], ['m³', 'l', 1000]]][LV[d]];
      const [vel, mal, k] = R.pick(rady), n = R.int(2, 40);
      return R.chance(0.5)
        ? { q: `${n} ${vel} = ____ ${mal}`, a: `${n * k} ${mal}` }
        : { q: `${n * k} ${mal} = ____ ${vel}`, a: `${n} ${vel}` };
    } },
    obdelnik: { r: [4, 5, 6, 7], t: '🔢 Obvod a obsah obdélníku', instr: 'Vypočítej a nezapomeň na jednotky.', gen(d, R) {
      const a = R.int(2, [10, 20, 40][LV[d]]), b = R.int(2, [10, 20, 40][LV[d]]);
      return R.chance(0.5)
        ? { q: `Obdélník a = ${a} cm, b = ${b} cm. Obvod o =`, a: `${2 * (a + b)} cm` }
        : { q: `Obdélník a = ${a} cm, b = ${b} cm. Obsah S =`, a: `${a * b} cm²` };
    } },
    // vText = odpověď se píše přímo do slova (doplňovačka), ne na linku za úlohu
    vyjmenovana: { r: [3, 4, 5, 6], vText: true, t: '📖 Vyjmenovaná slova (i/y)', instr: 'Doplň i, í, y nebo ý.', gen(d, R) {
      const it = R.pick(tier(VYJM, d));
      return { q: it.t, a: it.a };
    } },
    bpvm: { r: [2, 3, 4, 5], vText: true, t: '📖 Doplňovačka bě/pě/vě/mě', instr: 'Doplň chybějící skupinu hlásek.', gen(d, R) {
      const it = R.pick(tier(BPVM, d));
      return { q: it.w, a: it.f };
    } },
    synonyma: { r: [3, 4, 5, 6], t: '📖 Synonyma', instr: 'Napiš slovo souznačné.', gen(d, R) {
      const p = R.pick(tier(SYN, d));
      return R.chance(0.5) ? { q: `${p[0]} →`, a: p[1] } : { q: `${p[1]} →`, a: p[0] };
    } },
    antonyma: { r: [2, 3, 4, 5], t: '📖 Antonyma (opozita)', instr: 'Napiš slovo opačného významu.', gen(d, R) {
      const p = R.pick(tier(ANT, d));
      return { q: `${p[0]} →`, a: p[1] };
    } },
    veliciny: { r: [6, 7, 8, 9], t: '⚛️ Veličiny a jednotky', instr: 'Doplň značku veličiny a její jednotku.', gen(d, R) {
      const v = R.pick(tier(VELICINY, d));
      return { q: `${v[0]} → značka ____, jednotka ____`, a: `${v[1]}, ${v[2]} (${v[3]})` };
    } },
    zvirata: { r: [4, 5, 6, 7], t: '🧬 Zařaď živočicha', instr: 'Napiš, do které skupiny živočich patří.', gen(d, R) {
      const z = R.pick(tier(ZVIRATA, d));
      return { q: `${z[0]} →`, a: z[1] };
    } },
  };

  const selRocnik = $('testRocnik'), selTema = $('testTema'), selObt = $('testObtiznost');
  const selPocet = $('testPocet'), poleKod = $('testKod'), archEl = $('testList');
  let ukazReseni = false;
  let obtiznostRucne = false;   // jakmile si ji učitel přenastaví, ročník do ní přestane sahat

  for (let r = 1; r <= 9; r++) {
    selRocnik.appendChild(new Option(r + '. ročník', r));
  }
  selRocnik.value = 5;

  const proRocnik = r => Object.entries(G).filter(([, g]) => g.r.includes(+r));

  function naplnTemata() {
    const drive = selTema.value;
    selTema.innerHTML = '';
    selTema.appendChild(new Option('🎲 Mix témat ročníku', 'mix'));
    proRocnik(selRocnik.value).forEach(([id, g]) => selTema.appendChild(new Option(g.t, id)));
    selTema.value = [...selTema.options].some(o => o.value === drive) ? drive : 'mix';
  }

  const novyKod = () => {
    const zn = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';   // bez znaků, které se pletou (I, O, 0, 1)
    return Array.from({ length: 5 }, () => zn[Math.floor(Math.random() * zn.length)]).join('');
  };

  function slozList() {
    const kod = (poleKod.value || '').toUpperCase().replace(/[^A-Z0-9]/g, '') || novyKod();
    poleKod.value = kod;
    const rocnik = selRocnik.value, obt = selObt.value, pocet = +selPocet.value;
    // Do semínka jde i nastavení: stejný kód s jiným ročníkem má dát jiný list,
    // ale stejný kód se stejným nastavením pokaždé přesně tentýž.
    const R = makeRng(`${kod}|${rocnik}|${selTema.value}|${obt}|${pocet}`);
    // U míchaného listu se nebere celý ročník: z deseti úloh by vzniklo deset
    // témat po jedné úloze. Vybere se pár témat a úlohy se mezi ně rozdělí,
    // takže list vypadá jako opravdový test – několik oddílů po pár úlohách.
    const dostupne = proRocnik(rocnik);
    const vybrane = selTema.value === 'mix'
      ? R.shuffle(dostupne).slice(0, Math.min(dostupne.length, Math.max(2, Math.round(pocet / 4))))
      : [[selTema.value, G[selTema.value]]];
    if (!vybrane.length) return;

    const ulohy = [];
    const videne = new Set();
    for (let i = 0; i < pocet; i++) {
      const [, g] = vybrane[i % vybrane.length];
      let it = null;
      // pár pokusů na neopakující se zadání; banka témat je konečná, takže
      // se po vyčerpání smíří i s opakováním, jen se kvůli tomu nezacyklí
      for (let pokus = 0; pokus < 12; pokus++) {
        it = g.gen(obt, R);
        if (!videne.has(it.q)) break;
      }
      videne.add(it.q);
      ulohy.push({ ...it, instr: g.instr, tema: g.t, vText: !!g.vText });
    }

    // Úlohy se seskupí po tématech a každá skupina dostane nad sebe svůj pokyn.
    // Bez toho nebylo u míchaného listu poznat, co se u které úlohy má dělat –
    // „hustota →“ samo o sobě neřekne nic.
    const skupiny = new Map();
    ulohy.forEach(u => {
      if (!skupiny.has(u.tema)) skupiny.set(u.tema, { instr: u.instr, ulohy: [] });
      skupiny.get(u.tema).ulohy.push(u);
    });
    const poradiUloh = [...skupiny.values()].flatMap(sk => sk.ulohy);   // číslování jde podle vysázeného pořadí

    const nazev = selTema.value === 'mix'
      ? `Opakování – ${rocnik}. ročník`
      : G[selTema.value].t.replace(/^\S+\s/, '');
    const pokyny = skupiny.size > 1
      ? 'Úlohy jsou rozdělené do oddílů – pokyn platí vždy pro celý oddíl nad ním.'
      : ulohy[0].instr;
    const dnes = new Date().toLocaleDateString('cs-CZ');

    // Linka na odpověď se dopisuje jen tam, kde je opravdu potřeba: ne u
    // doplňovaček (píše se přímo do slova) a ne tam, kde si místo udělalo
    // samo zadání („značka ____, jednotka ____“) – jinak jsou na řádku dvě.
    const polozka = u => {
      const misto = u.vText || u.q.includes('____') ? '' : ' <span class="misto"></span>';
      return `<li><span class="zadani-listu">${u.q}${misto}</span></li>`;
    };
    const telo = skupiny.size > 1
      ? [...skupiny.entries()].map(([tema, sk]) =>
          `<li class="oddil"><b>${tema}</b> ${sk.instr}</li>` + sk.ulohy.map(polozka).join('')).join('')
      : ulohy.map(polozka).join('');

    archEl.innerHTML =
      `<h3>${nazev}</h3><div class="pokyn">${pokyny}</div>` +
      `<div class="hlavicka"><span>Jméno:</span><span>Třída:</span><span>Datum: ${dnes}</span></div>` +
      `<ol>${telo}</ol>` +
      (ukazReseni
        ? '<div class="reseni"><b>Řešení:</b> ' + poradiUloh.map((u, i) => `${i + 1}. ${u.a}`).join(' · ') + '</div>'
        : '') +
      `<div class="kod">Kód listu: ${kod}</div>`;
  }

  selRocnik.addEventListener('change', () => {
    if (!obtiznostRucne) {
      const r = +selRocnik.value;
      selObt.value = r <= 3 ? 'easy' : r <= 6 ? 'medium' : 'hard';
    }
    naplnTemata();
    slozList();
  });
  selObt.addEventListener('change', () => { obtiznostRucne = true; slozList(); });
  [selTema, selPocet].forEach(s => s.addEventListener('change', slozList));
  poleKod.addEventListener('change', slozList);
  $('testNovy').addEventListener('click', () => { poleKod.value = novyKod(); slozList(); });
  $('testReseni').addEventListener('click', e => {
    ukazReseni = !ukazReseni;
    e.currentTarget.textContent = ukazReseni ? '🙈 Skrýt řešení' : '👁 Ukázat řešení';
    slozList();
  });
  $('testTisk').addEventListener('click', () => window.print());

  naplnTemata();
  poleKod.value = novyKod();
  slozList();
}

</script>
</body>
</html>
