<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Metodus – přehled učiva</title>
  <link rel="stylesheet" href="../common.css">
  <script src="../theme.js"></script>
  <script src="../podpis.js" defer></script>
  <link rel="icon" href="../favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="../favicon.ico" sizes="16x16 32x32 48x48">
  <style>
    body {
      background-color: var(--bg-deep);
      padding: 28px clamp(16px, 4vw, 48px);
      min-height: 100vh;
    }

    header.uvod {
      margin-bottom: 26px;
      max-width: 720px;
    }
    header.uvod h1 {
      font-size: 1.6rem;
      font-weight: 650;
      margin-bottom: 8px;
    }
    header.uvod h1 .symbol {
      width: 1.3em;
      height: 0.97em;
      vertical-align: -0.1em;
      fill: var(--accent);
    }
    header.uvod p {
      color: var(--text-muted);
      font-size: 0.95rem;
      line-height: 1.5;
    }
    header.uvod .statistika {
      color: var(--text-faint);
      font-size: 0.8rem;
      margin-top: 8px;
    }

    section { margin-bottom: 30px; }
    section h2 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent);
      margin-bottom: 12px;
      font-weight: 700;
    }

    /* Předměty – velké dlaždice, klik nastaví filtr v menu rozcestníku */
    .predmety {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 12px;
    }
    .predmet {
      display: flex;
      flex-direction: column;
      gap: 4px;
      background-color: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 18px;
      color: var(--text);
      text-decoration: none;
      text-align: left;
      font-family: inherit;
      font-size: 0.95rem;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.12s ease, background-color 0.12s ease;
    }
    .predmet:hover {
      border-color: var(--accent);
      background-color: var(--bg-elevated);
      transform: translateY(-2px);
    }
    .predmet .nazev { font-weight: 600; }
    .predmet .pocet { color: var(--text-faint); font-size: 0.78rem; }
    .predmet .pocet .plan { color: var(--warn); }

    /* Rychlá volba ročníku */
    .rocniky {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .rocniky button {
      background-color: var(--bg-panel);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      padding: 10px 16px;
      font-size: 0.9rem;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.12s ease;
    }
    .rocniky button:hover {
      border-color: var(--accent);
      background-color: var(--bg-elevated);
      transform: translateY(-2px);
    }
    .rocniky button .pocet {
      display: block;
      color: var(--text-faint);
      font-size: 0.7rem;
    }

    /* Proužek s odkazem na osnovu */
    .osnova-pruh {
      display: flex;
      align-items: center;
      gap: 14px;
      background: linear-gradient(120deg, var(--accent-soft), transparent 70%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px 18px;
      flex-wrap: wrap;
    }
    .osnova-pruh .znak { font-size: 1.6rem; }
    .osnova-pruh .text b { display: block; margin-bottom: 3px; }
    .osnova-pruh .text span { color: var(--text-muted); font-size: 0.85rem; }
    .osnova-pruh a {
      margin-left: auto;
      background-color: var(--accent);
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.85rem;
    }
    .osnova-pruh a:hover { background-color: var(--accent-hover); }
    .predmet .temata {
      color: var(--text-muted);
      font-size: 0.78rem;
      line-height: 1.45;
      margin-top: 2px;
    }

    .dlazdice {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 12px;
    }
    .dlazdice a {
      display: flex;
      align-items: center;
      gap: 10px;
      background-color: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      color: var(--text);
      text-decoration: none;
      font-size: 0.9rem;
      transition: transform 0.12s ease, border-color 0.12s ease, background-color 0.12s ease;
      overflow: hidden;
    }
    .dlazdice a:hover {
      border-color: var(--accent);
      background-color: var(--bg-elevated);
      transform: translateY(-2px);
    }
    .dlazdice .emoji { font-size: 1.3rem; flex-shrink: 0; }
    .dlazdice .nazev {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .prazdne {
      color: var(--text-faint);
      font-size: 0.85rem;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      padding: 16px;
    }

    .tip {
      display: flex;
      align-items: center;
      gap: 14px;
      background: linear-gradient(120deg, var(--accent-soft), transparent 70%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 18px;
      flex-wrap: wrap;
    }
    .tip .emoji { font-size: 1.8rem; }
    .tip .text b { display: block; margin-bottom: 3px; }
    .tip .text span { color: var(--text-muted); font-size: 0.85rem; }
    .tip .tlacitka {
      margin-left: auto;
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }
    .tip a.otevrit, .tip button.nahodne {
      background-color: var(--accent);
      color: #fff;
      text-decoration: none;
      border: none;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.85rem;
      font-family: inherit;
      cursor: pointer;
    }
    .tip button.nahodne {
      background-color: var(--bg-control);
      color: var(--text-muted);
      border: 1px solid var(--border-strong);
    }
    .tip a.otevrit:hover { background-color: var(--accent-hover); }
    .tip button.nahodne:hover { background-color: var(--bg-hover); color: var(--text); }

    footer.pata {
      border-top: 1px solid var(--border);
      padding-top: 14px;
      color: var(--text-faint);
      font-size: 0.8rem;
      line-height: 1.6;
    }
    footer.pata a { color: var(--text-muted); }
  </style>
</head>
<body>
  <header class="uvod">
    <h1><svg class="symbol" viewBox="0 0 655 488" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g transform="translate(0,488) scale(0.1,-0.1)"><path d="M5911 4824 c-708 -239 -1389 -584 -1876 -950 -352 -264 -547 -485 -738 -835 -22 -40 -20 -42 -92 91 -182 335 -566 695 -1067 999 -428 259 -1117 569 -1582 710 -225 69 -459 -49 -526 -266 -33 -109 -31 -4397 3 -4463 39 -78 132 -121 215 -100 247 62 474 296 558 575 17 56 18 153 21 1635 1 866 2 1588 3 1604 0 40 33 34 285 -50 976 -324 1596 -753 1810 -1254 117 -274 117 -276 124 -1170 7 -837 2 -784 71 -843 111 -95 297 -66 363 56 22 42 22 42 28 817 5 741 6 779 26 865 124 529 489 910 1200 1252 354 169 962 387 984 351 5 -7 9 -727 9 -1599 0 -1587 0 -1587 25 -1673 45 -155 115 -267 238 -382 223 -208 448 -238 531 -72 26 52 26 52 26 2204 0 1529 -3 2168 -11 2206 -41 199 -219 348 -413 348 -35 0 -102 -17 -215 -56z"/></g></svg> Metodus</h1>
    <p>Interaktivní procvičování a názorné simulace pro 1. i 2. stupeň základní školy
       a střední školu. Vše běží přímo v prohlížeči – bez registrace, bez reklam,
       po prvním otevření i bez internetu.</p>
    <div class="statistika" id="statistika"></div>
  </header>

  <section>
    <h2>📅 Ročník</h2>
    <div class="rocniky" id="rocniky"></div>
  </section>

  <section>
    <h2>📚 Předměty</h2>
    <div class="predmety" id="predmety"></div>
  </section>

  <section>
    <h2>🗺️ Osnova</h2>
    <div class="osnova-pruh">
      <span class="znak" aria-hidden="true">🗺️</span>
      <div class="text">
        <b>Pokrytí učiva podle ročníků</b>
        <span id="osnovaPopis">Mřížka ročníků a předmětů s přehledem, co je hotové a co se připravuje.</span>
      </div>
      <a href="osnova.html" id="odkazOsnova">Otevřít osnovu</a>
    </div>
  </section>

  <section>
    <h2>🧑‍🏫 Pro učitele</h2>
    <div class="osnova-pruh">
      <span class="znak" aria-hidden="true">🧑‍🏫</span>
      <div class="text">
        <b>Kabinet učitele</b>
        <span>Pracovní listy k tisku, tvorba slidů na plátno a nástroje do hodiny –
          časovač, losování žáka, dělení do skupin, skóre týmů a semafor hluku.</span>
      </div>
      <a href="ucitel.html" id="odkazUcitel">Otevřít kabinet</a>
    </div>
  </section>

  <section>
    <h2>◈ O Metodusu</h2>
    <div class="osnova-pruh">
      <span class="znak" aria-hidden="true">◈</span>
      <div class="text">
        <b>Živé ukázky</b>
        <span>Gravitační hřiště, periodická tabulka, aerodynamický tunel a další – zkrácené, ale
          plně funkční ukázky na jedné stránce. Na ukázání kolegům, rodičům i na projektor.</span>
      </div>
      <a href="predstaveni.html" id="odkazPredstaveni">Otevřít ukázky</a>
    </div>
  </section>

  <section class="tip-sekce">
    <h2>💡 Tip na dnešek</h2>
    <div class="tip" id="tip"></div>
  </section>

  <section>
    <h2>⭐ Oblíbené</h2>
    <div class="dlazdice" id="oblibene"></div>
  </section>

  <section>
    <h2>🕘 Naposledy otevřené</h2>
    <div class="dlazdice" id="nedavne"></div>
  </section>

  <footer class="pata">
    Obsah slouží k procvičování, ne jako náhrada učebnice.
  </footer>

  <script src="../apps.js"></script>
  <script>
    /* Úvodní přehled Metodusu. Běží uvnitř rozcestníku (iframe) i samostatně:
       uvnitř posílá výběr rodičovskému oknu přes postMessage, samostatně
       otevře odkaz přímo. */
    const podleSouboru = new Map();
    KATALOG_SEKCE.forEach(s => s.polozky.forEach(p => podleSouboru.set(p.soubor, p)));
    const vsechny = [...podleSouboru.values()];
    const vRozcestniku = window.parent !== window;

    const nactiJson = key => {
      try { return JSON.parse(localStorage.getItem(key)) || []; }
      catch { return []; }
    };

    // rozdělení "🔢 Počítání" na emoji + text
    function rozdel(nazev) {
      const m = nazev.match(/^(\P{L}+)\s*(.*)$/u);
      return (m && m[2]) ? { emoji: m[1].trim(), text: m[2] } : { emoji: '🔹', text: nazev };
    }

    function odkaz(p, popisek) {
      const a = document.createElement('a');
      a.href = '../index.html#' + p.soubor;
      a.target = '_top';
      if (popisek) {
        a.className = 'otevrit';
        a.textContent = popisek;
      } else {
        const { emoji, text } = rozdel(p.nazev);
        const e = document.createElement('span');
        e.className = 'emoji';
        e.textContent = emoji;
        const n = document.createElement('span');
        n.className = 'nazev';
        n.textContent = text;
        a.append(e, n);
      }
      a.addEventListener('click', ev => {
        if (vRozcestniku) {
          ev.preventDefault();
          window.parent.postMessage({ otevri: p.soubor }, '*');
        }
      });
      return a;
    }

    const jeHotova = p => p.stav !== 'plan';

    /* ---- Rychlá volba ročníku ---- */
    const rocnikyEl = document.getElementById('rocniky');
    for (let r = 1; r <= 9; r++) {
      const pocet = vsechny.filter(p => (p.rocniky || []).includes(r) && jeHotova(p)).length;
      const b = document.createElement('button');
      b.innerHTML = `${r}. ročník<span class="pocet">${pocet} aplikací</span>`;
      b.addEventListener('click', () => {
        if (vRozcestniku) window.parent.postMessage({ rocnik: String(r) }, '*');
        else window.top.location.href = '../index.html#rocnik=' + r;
      });
      rocnikyEl.appendChild(b);
    }

    /* ---- Odkaz na osnovu ---- */
    const odkazOsnova = document.getElementById('odkazOsnova');
    odkazOsnova.addEventListener('click', ev => {
      if (vRozcestniku) {
        ev.preventDefault();
        window.parent.postMessage({ otevri: 'obsah/osnova.html' }, '*');
      }
    });
    document.getElementById('odkazUcitel').addEventListener('click', ev => {
      if (vRozcestniku) {
        ev.preventDefault();
        window.parent.postMessage({ otevri: 'obsah/ucitel.html' }, '*');
      }
    });
    document.getElementById('odkazPredstaveni').addEventListener('click', ev => {
      if (vRozcestniku) {
        ev.preventDefault();
        window.parent.postMessage({ otevri: 'obsah/predstaveni.html' }, '*');
      }
    });
    {
      const sPredmetem = vsechny.filter(p => p.predmet);
      const h = sPredmetem.filter(jeHotova).length;
      document.getElementById('osnovaPopis').textContent =
        `Hotovo ${h} z ${sPredmetem.length} témat osnovy ZŠ – mřížka ukazuje, co v kterém ročníku chybí.`;
    }

    /* ---- Předměty ---- */
    const predmetyEl = document.getElementById('predmety');
    KATALOG_SKUPINY.forEach(g => {
      const sekce = KATALOG_SEKCE.filter(s => s.skupina === g.id);
      if (!sekce.length) return;
      const vsechnyVSkupine = sekce.flatMap(s => s.polozky);
      const pocet = vsechnyVSkupine.filter(jeHotova).length;
      const planovano = vsechnyVSkupine.length - pocet;
      const { emoji, text } = rozdel(g.label);

      const el = document.createElement(vRozcestniku ? 'button' : 'a');
      el.className = 'predmet';
      if (!vRozcestniku) el.href = '../index.html#skupina=' + g.id;
      el.innerHTML =
        `<span class="nazev">${emoji} ${text}</span>` +
        `<span class="pocet">${pocet} ${pocet === 1 ? 'aplikace' : pocet < 5 ? 'aplikace' : 'aplikací'}` +
        (planovano ? ` · <span class="plan">${planovano} 🚧</span>` : '') + `</span>`;
      const temata = document.createElement('span');
      temata.className = 'temata';
      temata.textContent = sekce.map(s => rozdel(s.nazev).text).join(' · ');
      el.appendChild(temata);
      el.addEventListener('click', ev => {
        if (vRozcestniku) {
          ev.preventDefault();
          window.parent.postMessage({ skupina: g.id }, '*');
        }
      });
      predmetyEl.appendChild(el);
    });

    /* ---- Oblíbené a nedávné ---- */
    function naplnDlazdice(elId, soubory, prazdnyText) {
      const el = document.getElementById(elId);
      const apps = soubory.map(f => podleSouboru.get(f)).filter(Boolean);
      if (!apps.length) {
        const d = document.createElement('div');
        d.className = 'prazdne';
        d.textContent = prazdnyText;
        el.appendChild(d);
        return;
      }
      apps.forEach(p => el.appendChild(odkaz(p)));
    }

    naplnDlazdice('oblibene', nactiJson('metodus_oblibene'),
      'Zatím nic – najeďte v menu na aplikaci a klikněte na ★.');
    naplnDlazdice('nedavne', nactiJson('metodus_nedavne'),
      'Historie je prázdná – vyberte předmět výše nebo aplikaci v menu.');

    {
      const h = vsechny.filter(jeHotova).length;
      const plan = vsechny.length - h;
      // O připravovaných tématech se zmiňujeme, jen když nějaká jsou –
      // jinak by na úvodní stránce svítilo „a 0 připravovaných témat“.
      document.getElementById('statistika').textContent =
        `${h} hotových aplikací ` + (plan ? `a ${plan} připravovaných témat ` : '') +
        `v ${KATALOG_SKUPINY.length} oblastech a ${KATALOG_SEKCE.length} tematických okruzích.`;
    }

    /* ---- Tip dne (deterministicky podle data) + náhodný výběr ---- */
    const den = Math.floor(Date.now() / 86400000);
    const hotoveApky = vsechny.filter(jeHotova);
    const tipApp = hotoveApky[den % hotoveApky.length];
    const { emoji, text } = rozdel(tipApp.nazev);
    const tipEl = document.getElementById('tip');
    const te = document.createElement('span');
    te.className = 'emoji';
    te.textContent = emoji;
    const tt = document.createElement('div');
    tt.className = 'text';
    const b = document.createElement('b');
    b.textContent = text;
    const sub = document.createElement('span');
    sub.textContent = (tipApp.tagy || []).join(' · ') || 'Vyzkoušejte dnešní vybranou aplikaci.';
    tt.append(b, sub);

    const tlacitka = document.createElement('div');
    tlacitka.className = 'tlacitka';
    const nahodne = document.createElement('button');
    nahodne.className = 'nahodne';
    nahodne.textContent = '🎲 Náhodně';
    nahodne.addEventListener('click', () => {
      const p = hotoveApky[Math.floor(Math.random() * hotoveApky.length)];
      if (vRozcestniku) window.parent.postMessage({ otevri: p.soubor }, '*');
      else window.top.location.href = '../index.html#' + p.soubor;
    });
    tlacitka.append(nahodne, odkaz(tipApp, 'Otevřít'));
    tipEl.append(te, tt, tlacitka);
  </script>
</body>
</html>
