/* Názorné animace jaderné fyziky – barvy a ovladače navazují na Metodus. */
.transport { display:flex; flex-wrap:wrap; gap:9px; align-items:center; justify-content:center; }
.transport button, .transport select { font:inherit; font-size:.86rem; color:var(--text); background:var(--bg-control); border:1px solid var(--border-strong); padding:10px 13px; border-radius:9px; min-height:43px; cursor:pointer; }
.transport button:hover { border-color:var(--accent); background:var(--accent-soft); }
.transport button.primary { background:var(--accent); color:white; font-weight:650; }
.transport label { display:flex; align-items:center; gap:8px; font-size:.86rem; color:var(--text-muted); }
.transport button[aria-pressed="true"] { background:var(--accent-soft); border-color:var(--accent); }
.timeline { display:block; width:100%; margin:14px 0; accent-color:var(--accent); min-height:24px; cursor:pointer; }
.timeline-label { display:flex; justify-content:space-between; font-size:.84rem; color:var(--text-muted); margin-top:15px; }
.range-ends { display:flex; justify-content:space-between; gap:12px; font-size:.75rem; color:var(--text-muted); margin-bottom:14px; }
.fission-lab .transport { margin-top:12px; justify-content:flex-start; }
.fission-lab .panel { border-top:3px solid var(--accent); }
.eyebrow { display:block; text-transform:uppercase; letter-spacing:.1em; font-size:.7rem; color:var(--accent); margin-bottom:8px; }
.particle-key { display:flex; flex-wrap:wrap; gap:10px 18px; justify-content:center; font-size:.78rem; color:var(--text-muted); margin:10px 0; }
.particle-key span { display:inline-flex; gap:6px; align-items:center; }
.particle-key i { width:12px; height:12px; display:inline-block; border-radius:50%; }
.proton-dot { background:linear-gradient(135deg,#ffd499,#b64944); }
.neutron-dot { background:linear-gradient(135deg,#dafcff,#388ead); }
.particle-key .rod-dot { border-radius:2px; background:linear-gradient(90deg,#667f8c,#b7d6dd); }
.nuclear-art { display:block; aspect-ratio:760/440; }
.art-eyebrow { font-size:12px; letter-spacing:1.4px; fill:var(--text-muted); }
.art-label { font-size:16px; fill:var(--text-muted); }
.art-big { font-size:23px; font-weight:650; fill:var(--text); }
.scene-shell { width:100%; border:1px solid var(--border); border-radius:16px; background:var(--bg-deep); overflow:hidden; }
.reactor-canvas { width:100%; display:block; aspect-ratio:900/550; }
.reactor-controls, .plant-panels { width:100%; display:grid; grid-template-columns:1fr 1fr; gap:16px; text-align:left; }
.reactor-controls label, .plant-panels label { display:block; color:var(--text-muted); font-size:.87rem; }
.reactor-controls label b, .plant-panels label b { float:right; color:var(--accent); }
.reactor-controls .check-line { display:flex; gap:8px; align-items:center; margin:16px 0; }
.check-line input { accent-color:var(--accent); width:18px; height:18px; }
.plant-tools { width:100%; justify-content:flex-start; }
.plant-viewport { overflow:auto; overscroll-behavior:contain; }
.plant-viewport.zoomed .plant-art { min-width:1040px; }
.plant-art { display:block; width:100%; height:auto; font-family:inherit; }
.plant-art text { fill:var(--text); }
.plant-art .equipment { fill:url(#schMetal); stroke:#9fb7c5; stroke-width:2.2px; }
.plant-art .tower-body { fill:url(#schTower); stroke:#98b1be; stroke-width:2.2px; }
.plant-art .dil { cursor:pointer; }
.plant-art .dil:hover .obrys, .plant-art .dil.zap .obrys, .plant-art .dil:focus-visible .obrys { stroke:var(--accent); stroke-width:4px; filter:drop-shadow(0 0 5px var(--accent-soft)); }
.plant-art .device-label circle { fill:var(--accent); }
.plant-art .device-label text { font-size:15px; font-weight:600; }
.plant-art .device-label .number { fill:white; font-size:13px; }
.plant-art .pipe-label { font-size:13px; fill:var(--text-muted); }
.plant-art .energy-chain text { font-size:17px; fill:var(--text-muted); }
.loop-tools button[data-loop="primary"] { border-bottom:3px solid #ed8b71; }
.loop-tools button[data-loop="secondary"] { border-bottom:3px solid #70b5e5; }
.loop-tools button[data-loop="cooling"] { border-bottom:3px solid #61c9bd; }
.energy-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:18px; }
.energy-stats span { display:block; font-size:.7rem; color:var(--text-muted); margin-bottom:5px; }
.energy-stats b { font-size:1rem; }
.plocha .stavovky, .plocha .osudy { width:min(760px,100%); }
.plocha .verdikt { max-width:760px; font-size:.9rem; }
.transport select:focus-visible, .plant-viewport:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
@media(max-width:720px) {
 .reactor-controls, .plant-panels { grid-template-columns:1fr; }
 .fission-lab { gap:14px; }
 .plant-tools .vysvetlivka { font-size:.75rem; }
 .energy-stats b { font-size:.86rem; }
 .reactor-controls .panel { padding:12px; }
 .transport { gap:7px; }
}

.reactor-viewport { overflow:auto; overscroll-behavior:contain; }
.reactor-viewport.zoomed canvas { min-width:900px; }
.reactor-viewport:focus-visible { outline:3px solid var(--accent); outline-offset:3px; }
