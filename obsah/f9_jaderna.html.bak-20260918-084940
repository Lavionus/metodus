  <style>
    .schema { width: min(360px, 90%); }
    .schema .jadro { fill: var(--danger); }
    .schema .neutron { fill: var(--accent); }
    .schema .sipka { stroke: var(--text-muted); stroke-width: 2; marker-end: url(#hrot2); }
    .schema .popis { fill: var(--text-muted); font-size: 12px; text-anchor: middle; }
    .graf { width: min(360px, 90%); }
    .graf .osy { stroke: var(--text-muted); stroke-width: 2; }
    .graf .krivka { fill: none; stroke: var(--accent); stroke-width: 3; }
    .graf .mrizka { stroke: var(--border); stroke-width: 1; }
    .graf .popis { fill: var(--text-faint); font-size: 11px; text-anchor: middle; }
    .uloha-text { max-width: 640px; font-size: 1.02rem; line-height: 1.6; }
    .uloha-text b { color: var(--accent); }

    /* ---- interaktivní režimy ---- */
    canvas.scena { width: min(560px, 100%); height: auto; display: block;
      background: var(--bg-deep); border: 1px solid var(--border); border-radius: 10px; }
    .scena-svg { width: min(600px, 100%); display: block; }

    .ovladace { display: flex; flex-wrap: wrap; gap: 8px 12px; justify-content: center; max-width: 580px; }
    .ovladace label {
      display: flex; align-items: center; gap: 8px;
      background: var(--bg-input); border: 1px solid var(--border);
      border-radius: 8px; padding: 5px 10px; font-size: 0.8rem; color: var(--text-muted);
    }
    .ovladace input[type=range] { width: 120px; accent-color: var(--accent); }
    .ovladace .hodnota { color: var(--text); font-weight: 600; min-width: 3.2em; text-align: right;
      font-variant-numeric: tabular-nums; }
    .ovladace button {
      background: var(--bg-control); border: 1px solid var(--border-strong); color: var(--text);
      border-radius: 8px; padding: 8px 14px; font-size: 0.84rem; font-family: inherit; cursor: pointer;
    }
    .ovladace button:hover { border-color: var(--accent); }
