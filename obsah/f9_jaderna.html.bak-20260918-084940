      letter-spacing: 0.4px; }
    .stavovky .cislo { font-size: 1.2rem; font-weight: 700; margin-top: 2px;
      font-variant-numeric: tabular-nums; }
    .stavovky .a .cislo { color: var(--accent); }
    .stavovky .b .cislo { color: var(--warn); }
    .stavovky .c .cislo { color: var(--ok); }
    .stavovky .d .cislo { color: var(--danger); }
    @media (max-width: 560px) { .stavovky { grid-template-columns: repeat(2, 1fr); } }

    .verdikt { font-size: 0.95rem; font-weight: 600; min-height: 1.5rem; }
    .verdikt.podkriticka { color: var(--accent); }
    .verdikt.kriticka { color: var(--ok); }
    .verdikt.nadkriticka { color: var(--danger); }

    /* pruh osudů neutronů */
    .osudy { width: min(560px, 100%); }
    .osudy .pruhy { display: flex; gap: 3px; height: 13px; }
    .osudy .pruhy div { border-radius: 3px; min-width: 2px; }
    .osudy .stitky { display: flex; flex-wrap: wrap; gap: 6px 16px; justify-content: center;
      margin-top: 6px; font-size: 0.76rem; color: var(--text-muted); }
    .osudy .stitky span { display: inline-flex; align-items: center; gap: 5px; }
    .osudy .stitky i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }

    /* schéma elektrárny */
    .scena-svg .budova { fill: var(--bg-elevated); stroke: var(--border-strong); stroke-width: 2; }
    .scena-svg .dil { cursor: pointer; }
    .scena-svg .dil:hover .obrys { stroke: var(--accent); }
    .scena-svg .dil.zap .obrys { stroke: var(--accent); stroke-width: 3; }
    .scena-svg .obrys { fill: var(--bg-elevated); stroke: var(--border-strong); stroke-width: 2; }
    .scena-svg .primar { stroke: #d96a6a; stroke-width: 5; fill: none; stroke-linecap: round; }
    .scena-svg .sekundar { stroke: #6aa6fd; stroke-width: 5; fill: none; stroke-linecap: round; }
    .scena-svg .terciar { stroke: #6ad0c0; stroke-width: 5; fill: none; stroke-linecap: round; }
    .scena-svg .popis { fill: var(--text-muted); font-size: 11px; text-anchor: middle; }
    .scena-svg .popis.male { font-size: 10px; }
    .vysvetlivka { color: var(--text-faint); font-size: 0.84rem; max-width: 580px; line-height: 1.55; }
    .vysvetlivka b { color: var(--text-muted); }
    .legenda { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center;
      font-size: 0.76rem; color: var(--text-muted); }
    .legenda span { display: inline-flex; align-items: center; gap: 5px; }
    .legenda i { width: 14px; height: 4px; border-radius: 2px; display: inline-block; }
    body { max-width: 1160px; margin: auto; }
    .plocha { max-width: 1060px; width: 100%; box-sizing: border-box; justify-content: flex-start; }
    .plocha > * { min-width: 0; max-width: 100%; }
    .laborator { width: 100%; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(230px, 1fr); gap: 22px; text-align: left; align-items: start; }
    .laborator svg { width: 100%; height: auto; background: var(--bg-deep); border: 1px solid var(--border); border-radius: 16px; }
    .laborator svg text { fill: var(--text); font-family: inherit; }
    .panel, .pokus { background: var(--bg-input); border: 1px solid var(--border); border-radius: 12px; padding: 16px; line-height: 1.6; }
    .panel h2 { font-size: 1.12rem; margin: 0 0 10px; }
    .panel p { margin: 8px 0; }
    .pokus { width: min(650px, 100%); box-sizing: border-box; text-align: left; border-left: 4px solid var(--accent); }
    .kroky { display: flex; flex-wrap: wrap; gap: 7px; margin: 12px 0; }
    .kroky button, .panel button, .pokus button { font: inherit; font-size: .88rem; padding: 9px 12px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--bg-control); color: var(--text); cursor: pointer; min-height: 42px; }
    .kroky button[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); }
    button:focus-visible, input:focus-visible, .dil:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
    button:disabled { opacity: .5; cursor: default; }
    .rovnice { font-size: clamp(1rem, 2.5vw, 1.4rem); line-height: 2; font-weight: 650; text-align: center; padding: 12px; background: var(--accent-soft); border-radius: 12px; }
    .mereni { border-collapse: collapse; width: 100%; font-size: .84rem; }
    .mereni th, .mereni td { border-bottom: 1px solid var(--border); padding: 7px; text-align: right; }
    .mereni th:first-child, .mereni td:first-child { text-align: left; }
    .tok { display: flex; height: 26px; border-radius: 5px; overflow: hidden; margin: 12px 0; }
    .tok span:first-child { background: var(--accent); } .tok span:last-child { background: var(--warn); }
    .zdroje { max-width: 900px; color: var(--text-muted); font-size: .8rem; margin-top: 22px; }
    .zdroje a { color: var(--accent); }
    .ovladace label { flex-wrap: wrap; max-width: 100%; box-sizing: border-box; }
    .ovladace button { min-height: 42px; }
    .stavovky .cislo { font-size: 1.04rem; }
    .scena-svg .dil:focus-visible .obrys { stroke: var(--accent); stroke-width: 4; }
    .b .cislo { color: var(--zvyraz-text); } .c .cislo { color: var(--ok-text); } .d .cislo { color: var(--danger-text); }
    @media(max-width: 720px) { .laborator { grid-template-columns: 1fr; } .plocha { padding: 18px 12px; } }
    @media(prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  </style>
</head>
<body>
  <h1>☢️ Jaderná energie</h1>
  <p class="podtitul">Pro 9. ročník: štěpení jader, poločas rozpadu, jaderná elektrárna a bezpečnost.</p>

  <div class="rezimy" id="rezimy" role="group" aria-label="Výukové režimy">
    <button data-rezim="dej" class="active">⚛️ Štěpení krok za krokem</button>
    <button data-rezim="retezovka">☢️ Řetězová reakce</button>
    <button data-rezim="rozpad">⏳ Rozpad naživo</button>
    <button data-rezim="schema">🏭 Elektrárna zblízka</button>
    <button data-rezim="stepeni">🧠 Kvíz: štěpení</button>
    <button data-rezim="polocas">📉 Kvíz: poločas</button>
    <button data-rezim="provoz">⚖️ Provoz a zdroje</button>
  </div>

  <main class="plocha" id="plocha" aria-label="Interaktivní laboratoř"></main>

  <div class="ovladani">
    <button class="hlavni" id="btnDalsi">Přeskočit →</button>
    <span class="skore" id="skore"></span>
  </div>

  <p class="napoveda">
    Při <b>štěpení</b> se těžké jádro (uran 235) po zásahu neutronem rozpadne a uvolní energii
    i další neutrony – vzniká <b>řetězová reakce</b>. V reaktoru se řídí regulačními tyčemi.
    <b>Poločas rozpadu</b> je doba, za kterou se rozpadne polovina jader – nikoli odpočet,
    ale statistika: každé jádro se rozpadá náhodně.
  </p>

<details class="zdroje"><summary>O modelech a zdrojích</summary><p>Modely jsou výuková zjednodušení, rozměry ani rychlosti částic nejsou v měřítku. Elektrárna představuje tlakovodní typ; bilance používá modelovou účinnost přibližně 33 %. Poločasy v úlohách jsou zaokrouhlené.</p><p>Podklady: <a href="https://www.nrc.gov/reactors/power/pwrs">NRC – tlakovodní reaktor</a>, <a href="https://www.nrc.gov/reading-rm/basic-ref/students/animated-pwr">NRC – oddělení okruhů</a>.</p></details>
<script>
const $ = id => document.getElementById(id);
const skore = Uloha.skore('metodus_f9_jaderna', $('skore'));
let rezim = 'dej';
const omezenyPohyb = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
const fmt = x => Number(Number(x).toFixed(2)).toLocaleString('cs-CZ');
function odezvaEl() { const d = document.createElement('div'); d.className = 'odezva'; return d; }

/* ============================================================
   1) Řetězová reakce
   Neutron může skončit trojím způsobem a každý je vidět zvlášť:
     • trefí jádro → štěpení a 2–3 nové neutrony,
     • pohltí ho regulační tyč,
     • uteče z aktivní zóny ven (to je ten důvod, proč existuje kritické množství).
   Z poměru těchto tří osudů se počítá součinitel násobení k = ν · (štěpení / všechny konce).
   ============================================================ */
const RR = {
  jadra: [], neutrony: [], zabliknuti: [],
  polomer: 105, pohlceni: 30, reflektor: false, tyce: [],
  stepeni: 0, pohlceno: 0, uniklo: 0,
  okno: [], populace: [],
  cas: 0, animace: null, ctx: null, paused: false, limit: false,
};
const RR_W = 560, RR_H = 320;
const RR_STRED = { x: RR_W / 2, y: RR_H / 2 };
const RR_HUSTOTA = 480;        // jedno jádro na 480 px² – řídí střední volnou dráhu
const RR_NU = 2.5;             // průměrný počet neutronů z jednoho štěpení U-235
const RR_DOSAH = 13;           // účinný průřez jádra (větší než nakreslená tečka)
/* Rozštěpené jádro je krátce šedé jen jako záblesk děje. Kdyby chybělo dlouho,
   palivo by se v místě reakce vyprázdnilo a neutrony by odtud jen prolétly ven —
   simulace by pak ukazovala únik i tam, kde ve skutečnosti žádný není. */
const RR_OBNOVA = 0.6;
const RR_ODRAZ = 0.7;          // reflektor vrátí 70 % neutronů, zbytek stejně unikne
const RR_TYC_SIRKA = 11;       // polovina šířky regulační tyče v pixelech

/* Tyče kreslíme i vyhodnocujeme ze stejného seznamu – co je vidět, to taky pohlcuje. */
function rrTyce() {
  const pocet = Math.round(RR.pohlceni / 90 * 7);
  const tyce = [];
  for (let i = 0; i < pocet; i++) {
    tyce.push(RR_STRED.x - RR.polomer + (i + 0.5) * (2 * RR.polomer / pocet));
  }
  return tyce;
}

function rrRozmisti() {
  const R = RR.polomer;
  const kolik = Math.round(Math.PI * R * R / RR_HUSTOTA);
  RR.jadra = [];
  for (let i = 0; i < kolik; i++) {
    // rovnoměrně v kruhu: odmocnina zabrání shluku uprostřed
    const a = Math.random() * Math.PI * 2, r = Math.sqrt(Math.random()) * (R - 12);
    RR.jadra.push({ x: RR_STRED.x + Math.cos(a) * r, y: RR_STRED.y + Math.sin(a) * r, obnovaV: 0 });
  }
}
function rrReset() {
  rrRozmisti();
  RR.neutrony = []; RR.zabliknuti = [];
  RR.stepeni = 0; RR.pohlceno = 0; RR.uniklo = 0;
  RR.okno = []; RR.populace = []; RR.cas = 0; RR.limit = false;
}

function retezovka() {
  const p = $('plocha');
  p.innerHTML = `
    <div class="zadani uloha-text" style="max-width:560px">Vystřel neutron do paliva. Každý neutron
      skončí jedním ze tří způsobů — <b style="color:var(--ok)">rozštěpí jádro</b>,
      <b style="color:var(--text-faint)">pohltí ho tyč</b>, nebo
      <b style="color:var(--danger)">uteče ven</b>. Na jejich poměru závisí, jestli se reakce udrží.</div>
    <canvas role="img" aria-label="Pohyb neutronů v palivu; počty a osudy jsou uvedeny pod modelem" class="scena" id="plátnoRR" width="${RR_W}" height="${RR_H}"></canvas>
    <div class="ovladace" id="scenare">
      <button data-scenar="pod">🔵 Málo paliva</button>
      <button data-scenar="krit">🟢 Reaktor</button>
      <button data-scenar="nad">🔴 Bez tyčí</button>
    </div>
    <div class="ovladace">
      <button id="btnNeutron" class="hlavniAkce">⚛️ Vystřel neutron</button>
      <label>🧱 Množství paliva
        <input type="range" id="posPalivo" min="45" max="150" step="5" value="${RR.polomer}">
        <span class="hodnota" id="hodPalivo"></span></label>
      <label>🎛️ Regulační tyče
        <input type="range" id="posTyce" min="0" max="90" step="5" value="${RR.pohlceni}">
        <span class="hodnota" id="hodTyce"></span></label>
      <label><input type="checkbox" id="chkReflektor"> 🪞 Reflektor</label>
      <button id="rrPause">⏸ Pauza</button><button id="rrStep">Krok 0,1 s</button><button id="btnResetRR">↺ Reset</button>
    </div>
    <div class="stavovky">
      <div class="bunka a"><div class="nadpis">Neutrony v letu</div><div class="cislo" id="rrNeutrony"></div></div>
      <div class="bunka c"><div class="nadpis">Štěpení celkem</div><div class="cislo" id="rrStepeni"></div></div>
      <div class="bunka d"><div class="nadpis">Uniklo ven</div><div class="cislo" id="rrUniklo"></div></div>
      <div class="bunka b"><div class="nadpis">Součinitel k</div><div class="cislo" id="rrK"></div></div>
    </div>
    <div class="osudy" id="rrOsudy"></div>
    <p class="verdikt" id="rrVerdikt"></p>
    <aside class="pokus"><b>Badatelský úkol: kam mizí neutrony?</b><p>Spusť „Bez tyčí“, pak přidej tyče. Sleduj podíl pohlcených neutronů. Pokus několikrát opakuj: jedna náhodná reakce může uhasnout i při podmínkách příznivých pro růst.</p><details><summary>Jak číst součinitel k?</summary>k &lt; 1: reakce v průměru slábne. k = 1: udržuje se. k &gt; 1: roste. Zde jde jen o odhad z posledních 3 sekund modelu, nikoli měření skutečného reaktoru.</details></aside>
    <p class="vysvetlivka">Malá hromádka paliva má velký povrch vůči objemu, takže většina neutronů
      uteče dřív, než něco trefí — proto existuje <b>kritické množství</b>. Zkus palivo zvětšit,
      nebo zapnout <b>reflektor</b>, který neutrony odráží zpátky.<br>
      Rozštěpená jádra se tu po chvíli obnovují: ve skutečném reaktoru je jich tolik, že se
      za tuhle dobu spotřebuje jen nepatrný zlomek.</p>`;

  RR.paused = omezenyPohyb();
  $('rrPause').textContent = RR.paused ? '▶ Pokračovat' : '⏸ Pauza';
  $('rrPause').onclick = () => { RR.paused = !RR.paused; $('rrPause').textContent = RR.paused ? '▶ Pokračovat' : '⏸ Pauza'; };
  $('rrStep').onclick = () => { RR.paused = true; $('rrPause').textContent = '▶ Pokračovat'; for(let i=0;i<5;i++) rrKrok(.02); rrKresli(); rrStavovky(); };
  $('chkReflektor').checked = RR.reflektor;
  RR.ctx = $('plátnoRR').getContext('2d');
  rrReset();
  $('btnNeutron').addEventListener('click', () => rrVystrel());
  $('btnResetRR').addEventListener('click', () => { rrReset(); rrKresli(); rrStavovky(); });
  $('posPalivo').addEventListener('input', e => {
    RR.polomer = +e.target.value;
    rrRozmisti();
    RR.tyce = rrTyce();
    $('hodPalivo').textContent = RR.jadra.length + ' jader';
  });
  $('posTyce').addEventListener('input', e => {
    RR.pohlceni = +e.target.value;
    RR.tyce = rrTyce();
    $('hodTyce').textContent = RR.tyce.length + (RR.tyce.length === 1 ? ' tyč' : RR.tyce.length < 5 ? ' tyče' : ' tyčí');
  });
  $('chkReflektor').addEventListener('change', e => { RR.reflektor = e.target.checked; });
  $('scenare').addEventListener('click', e => {
    const b = e.target.closest('button[data-scenar]');
    if (!b) return;
    // Ilustrativní výchozí podmínky; skutečný průběh tohoto modelu je náhodný.
    const s = { pod: [45, 0, false], krit: [105, 45, false], nad: [150, 0, false] }[b.dataset.scenar];
    $('posPalivo').value = s[0]; $('posPalivo').dispatchEvent(new Event('input', { bubbles: true }));
    $('posTyce').value = s[1]; $('posTyce').dispatchEvent(new Event('input', { bubbles: true }));
    $('chkReflektor').checked = s[2];
    $('chkReflektor').dispatchEvent(new Event('change', { bubbles: true }));
    rrReset();
    for (let i = 0; i < 4; i++) rrVystrel();
  });
  RR.tyce = rrTyce();
  $('hodPalivo').textContent = RR.jadra.length + ' jader';
  $('hodTyce').textContent = RR.tyce.length + (RR.tyce.length === 1 ? ' tyč' : RR.tyce.length < 5 ? ' tyče' : ' tyčí');
  rrKresli(); rrStavovky();
  rrStart();
}

function rrVystrel() {
  const a = Math.random() * Math.PI * 2;
  RR.neutrony.push({
    x: RR_STRED.x, y: RR_STRED.y,
    vx: Math.cos(a) * 150, vy: Math.sin(a) * 150,
  });
  if (!RR.animace) rrStart();
}

function rrStart() {
  if (RR.animace) cancelAnimationFrame(RR.animace);
  let posledni = null;
  const krok = t => {
    if (!$('plátnoRR')) { RR.animace = null; return; }     // uživatel přepnul režim
    if (posledni === null) posledni = t;
    const dt = Math.min(0.05, (t - posledni) / 1000);
    posledni = t;
    if (!RR.paused && !document.hidden) rrKrok(dt);
    rrKresli();
    rrStavovky();
    RR.animace = requestAnimationFrame(krok);
  };
  RR.animace = requestAnimationFrame(krok);
}

/* Zaznamená osud neutronu do klouzavého okna, ze kterého se počítá k. */
function rrOsud(druh) {
  RR.okno.push({ t: RR.cas, druh });
  if (druh === 'stepeni') RR.stepeni++;
  else if (druh === 'pohlceno') RR.pohlceno++;
  else RR.uniklo++;
}

function rrKrok(dt) {
  RR.cas += dt;

  // obnova rozštěpených jader
  for (const j of RR.jadra) if (j.obnovaV && RR.cas > j.obnovaV) j.obnovaV = 0;

  const zbyle = [];
  for (const n of RR.neutrony) {
    n.x += n.vx * dt;
    n.y += n.vy * dt;

    const dx = n.x - RR_STRED.x, dy = n.y - RR_STRED.y;
    const vzdalenost = Math.hypot(dx, dy);

    // 1) opuštění aktivní zóny
    if (vzdalenost > RR.polomer) {
      if (RR.reflektor && Math.random() < RR_ODRAZ) {
        // odraz od stěny reflektoru: otočíme složku rychlosti kolmou ke stěně
        const nx = dx / vzdalenost, ny = dy / vzdalenost;
        const skalar = n.vx * nx + n.vy * ny;
        n.vx -= 2 * skalar * nx; n.vy -= 2 * skalar * ny;
        n.x = RR_STRED.x + nx * (RR.polomer - 1);
        n.y = RR_STRED.y + ny * (RR.polomer - 1);
      } else {
        rrOsud('uniklo');
        continue;
      }
    }

    // 2) pohlcení regulační tyčí – jen když neutron právě prolétá tyčí
    let vTyci = false;
    for (const tx of RR.tyce) if (Math.abs(n.x - tx) < RR_TYC_SIRKA) { vTyci = true; break; }
    if (vTyci && Math.random() < dt * 14) { rrOsud('pohlceno'); continue; }

    // 3) zásah jádra
    let zasah = null;
    for (const j of RR.jadra) {
      if (j.obnovaV) continue;
      if (Math.hypot(n.x - j.x, n.y - j.y) < RR_DOSAH) { zasah = j; break; }
    }
    if (zasah) {
      zasah.obnovaV = RR.cas + RR_OBNOVA;
      rrOsud('stepeni');
      if (RR.zabliknuti.length < 25) RR.zabliknuti.push({ x: zasah.x, y: zasah.y, t: 0.18 });
      const kolik = Math.random() < 0.5 ? 2 : 3;
      for (let k = 0; k < kolik; k++) {
        const uhel = Math.random() * Math.PI * 2;
        zbyle.push({ x: zasah.x, y: zasah.y, vx: Math.cos(uhel) * 150, vy: Math.sin(uhel) * 150 });
      }
    } else {
      zbyle.push(n);
    }
  }
  if (zbyle.length > 500) RR.limit = true;
  RR.neutrony = zbyle.slice(0, 500);           // pojistka proti zamrznutí při lavině

  for (const z of RR.zabliknuti) z.t -= dt;
  RR.zabliknuti = RR.zabliknuti.filter(z => z.t > 0);

  // klouzavé okno 3 s pro výpočet k
  RR.okno = RR.okno.filter(o => RR.cas - o.t < 3);
  RR.populace.push(RR.neutrony.length);
  if (RR.populace.length > 240) RR.populace.shift();
}

/* k = ν · podíl neutronů, které skončily štěpením */
function rrSoucinitel() {
  const celkem = RR.okno.length;
  if (celkem < 6) return null;
  const st = RR.okno.filter(o => o.druh === 'stepeni').length;
  return RR_NU * st / celkem;
}

function rrKresli() {
  const c = RR.ctx;
  if (!c) return;
  const s = getComputedStyle(document.documentElement);
  const barva = n => s.getPropertyValue(n).trim();
  c.clearRect(0, 0, RR_W, RR_H);

  // aktivní zóna a případný reflektor
  if (RR.reflektor) {
    c.beginPath();
    c.arc(RR_STRED.x, RR_STRED.y, RR.polomer + 7, 0, Math.PI * 2);
    c.strokeStyle = barva('--ok'); c.lineWidth = 5; c.globalAlpha = 0.55; c.stroke();
    c.globalAlpha = 1;
  }
  c.beginPath();
  c.arc(RR_STRED.x, RR_STRED.y, RR.polomer, 0, Math.PI * 2);
  c.strokeStyle = barva('--border-strong'); c.lineWidth = 1.5;
  c.setLineDash([5, 5]); c.stroke(); c.setLineDash([]);

  // jádra
  for (const j of RR.jadra) {
    c.beginPath();
    c.arc(j.x, j.y, j.obnovaV ? 4 : 8, 0, Math.PI * 2);
    c.fillStyle = j.obnovaV ? barva('--border') : barva('--danger');
    c.fill();
  }

  // záblesky štěpení
  for (const z of RR.zabliknuti) {
    const f = z.t / 0.18;
    c.beginPath();
    c.arc(z.x, z.y, 9 + (1 - f) * 13, 0, Math.PI * 2);
    c.strokeStyle = barva('--warn'); c.globalAlpha = f * 0.8; c.lineWidth = 2.5;
    c.stroke(); c.globalAlpha = 1;
  }

  // regulační tyče – svislé pruhy přes aktivní zónu
  c.fillStyle = barva('--text-faint'); c.globalAlpha = 0.5;
  for (const tx of RR.tyce) {
    const dy = Math.sqrt(Math.max(0, RR.polomer * RR.polomer - (tx - RR_STRED.x) ** 2));
    c.fillRect(tx - RR_TYC_SIRKA, RR_STRED.y - dy, RR_TYC_SIRKA * 2, 2 * dy);
  }
  c.globalAlpha = 1;

  // neutrony
  for (const n of RR.neutrony) {
    c.beginPath();
    c.arc(n.x, n.y, 3.6, 0, Math.PI * 2);
    c.fillStyle = barva('--accent');
    c.fill();
  }

  // graf populace neutronů
  const GW = 150, GH = 56, GX = RR_W - GW - 12, GY = 12;
  c.fillStyle = barva('--bg-panel'); c.globalAlpha = 0.85;
  c.fillRect(GX, GY, GW, GH); c.globalAlpha = 1;
  c.strokeStyle = barva('--border'); c.lineWidth = 1; c.strokeRect(GX, GY, GW, GH);
  const max = Math.max(8, ...RR.populace);
  c.strokeStyle = barva('--accent'); c.lineWidth = 1.8; c.beginPath();
  RR.populace.forEach((v, i) => {
    const x = GX + i / 240 * GW, y = GY + GH - v / max * (GH - 6);
    i ? c.lineTo(x, y) : c.moveTo(x, y);
  });
  c.stroke();
  c.fillStyle = barva('--text-faint'); c.font = '10px sans-serif'; c.textAlign = 'left';
  c.fillText('neutrony v čase', GX + 4, GY + GH + 12);
}

function rrStavovky() {
  if (!$('rrNeutrony')) return;
  $('rrNeutrony').textContent = RR.neutrony.length;
  $('rrStepeni').textContent = RR.stepeni;
  $('rrUniklo').textContent = RR.uniklo;

  const k = rrSoucinitel();
  $('rrK').textContent = k === null ? '—' : fmt(k);

  // rozpad osudů na tři pruhy
  const celkem = RR.stepeni + RR.pohlceno + RR.uniklo;
  const proc = n => celkem ? Math.round(n / celkem * 100) : 0;
  // popisky jsou pod pruhem v jedné řádce – v úzkém úseku by se ořízly
  $('rrOsudy').innerHTML = celkem
    ? `<div class="pruhy">
         <div style="flex:${Math.max(RR.stepeni, 0.01)};background:var(--ok)"></div>
         <div style="flex:${Math.max(RR.pohlceno, 0.01)};background:var(--text-faint)"></div>
         <div style="flex:${Math.max(RR.uniklo, 0.01)};background:var(--danger)"></div>
       </div>
       <div class="stitky">
         <span><i style="background:var(--ok)"></i>štěpení ${proc(RR.stepeni)} %</span>
         <span><i style="background:var(--text-faint)"></i>pohltily tyče ${proc(RR.pohlceno)} %</span>
         <span><i style="background:var(--danger)"></i>uniklo ven ${proc(RR.uniklo)} %</span>
       </div>`
    : `<div class="pruhy"><div style="flex:1;background:var(--border)"></div></div>
       <div class="stitky"><span>zatím žádný neutron neskončil</span></div>`;

  const el = $('rrVerdikt');
  if (RR.limit) { el.textContent = 'Dosažen limit 500 zobrazených neutronů. Model už růst nezobrazuje věrně; přidej tyče nebo spusť nový pokus.'; return; }
  if (k === null) {
    el.className = 'verdikt';
    el.textContent = RR.neutrony.length
      ? '⚪ Zatím málo událostí pro odhad k. Nech model běžet nebo jej krokuj.'
      : 'Zmáčkni „Vystřel neutron“. Zkus nejdřív malé palivo, pak velké.';
  } else if (k < 0.95) {
    el.className = 'verdikt podkriticka';
    el.textContent = `🔵 Podkritická (k = ${fmt(k)}) — každá generace je slabší než ta předchozí, reakce uhasne.`;
  } else if (k > 1.08) {
    el.className = 'verdikt nadkriticka';
    el.textContent = `🔴 Nadkritická (k = ${fmt(k)}) — každá generace je početnější, počet neutronů roste lavinovitě.`;
  } else {
    el.className = 'verdikt kriticka';
    el.textContent = `🟢 Kritická (k = ${fmt(k)}) — odhad je blízko 1. Ve stabilním reaktoru jedno štěpení v průměru vyvolá jedno další.`;
  }
}

/* ============================================================
   2) Rozpad naživo – jednotlivé pokusy kolísají kolem teoretické křivky.
   ============================================================ */
const RZ = { jadra: [], t: 0, bezi: false, rychlost: 1, animace: null, mereni: [], izotop: 0 };
const RZ_POCET = 300, RZ_W = 560, RZ_H = 170;

function rzReset() {
  RZ.bezi = false;
  if ($('btnRZStart')) $('btnRZStart').textContent = '▶️ Spustit čas';
  if ($('rzHotovo')) $('rzHotovo').textContent = '';
  if ($('mereniBody')) $('mereniBody').innerHTML = '';
  if ($('rzZapis')) $('rzZapis').textContent = '';
  RZ.jadra = [];
  for (let i = 0; i < RZ_POCET; i++) {
    RZ.jadra.push({
      x: 12 + (i % 30) * ((RZ_W - 24) / 29),
      y: 14 + Math.floor(i / 30) * ((RZ_H - 28) / 9),
      zive: true,
    });
  }
  RZ.t = 0;
  RZ.mereni = [[0, RZ_POCET]];
}

function rozpad() {
  const p = $('plocha');
  const iz = IZOTOPY[RZ.izotop];
  p.innerHTML = `
    <div class="zadani uloha-text" style="max-width:560px">Každé jádro se rozpadá <b>náhodně</b> —
      nelze předpovědět které a kdy. Výsledky jednotlivých pokusů kolísají kolem teoretické křivky. Sleduj, kolik jich zbývá
      po každém poločasu.</div>
    <div class="ovladace" id="izotopy">${IZOTOPY.map((z, i) =>
      `<button data-iz="${i}"${i === RZ.izotop ? ' class="hlavniAkce"' : ''}>${z.n}</button>`).join('')}</div>
    <canvas role="img" aria-label="Vzorek 300 jader, velké tečky jsou původní jádra, malé přeměněná" class="scena" id="plátnoRZ" width="${RZ_W}" height="${RZ_H}"></canvas>
    <canvas role="img" aria-label="Graf zbývajících jader: plná čára je pokus, čárkovaná teorie; hodnoty jsou dostupné v zápisníku" class="scena" id="plátnoRZG" width="${RZ_W}" height="150"></canvas>
    <div class="ovladace">
      <button id="btnRZStart" class="hlavniAkce">▶️ Spustit čas</button>
      <button id="rzStep">+ 1 poločas a zapsat</button><button id="rzSave">Zapsat měření</button><button id="btnRZReset">↺ Nový pokus</button>
      <label>⏩ Rychlost
        <input type="range" id="posRychlost" min="0.2" max="4" step="0.2" value="${RZ.rychlost}">
        <span class="hodnota" id="hodRychlost"></span></label>
    </div>
    <div class="stavovky">
      <div class="bunka a"><div class="nadpis">Zbývá jader</div><div class="cislo" id="rzZbyva"></div></div>
      <div class="bunka b"><div class="nadpis">Uplynulo poločasů</div><div class="cislo" id="rzPolocasy"></div></div>
      <div class="bunka c"><div class="nadpis">Skutečný čas</div><div class="cislo" id="rzCas"></div></div>
      <div class="bunka d"><div class="nadpis">Teorie říká</div><div class="cislo" id="rzTeorie"></div></div>
    </div>
    <p class="verdikt" id="rzHotovo" role="status"></p>
    <aside class="pokus"><b>Nejdřív odhadni, potom změř</b><p>Ze 300 jader by po dvou poločasech mělo v průměru zbýt 75. Vyzkoušej dva kroky, pak nový vzorek. Dostaneš přesně stejné číslo?</p><table class="mereni"><caption>Zápisník pokusu (posledních 8 měření)</caption><thead><tr><th>Čas / T</th><th>Zbývá</th><th>Teorie</th><th>Odchylka</th></tr></thead><tbody id="mereniBody"></tbody></table><p id="rzZapis" role="status"></p></aside>
    <p class="vysvetlivka">Zaokrouhlený poločas izotopu <b>${iz.n}</b> je ${iz.t} ${iz.jednotka}. Modrá je skutečný
      počet jader v simulaci, oranžová je teoretická křivka. U většího vzorku bývá relativní odchylka menší. Malé tečky označují přeměněná jádra, nikoli zmizelou hmotu.</p>`;

  rzReset();
  $('izotopy').addEventListener('click', e => {
    const b = e.target.closest('button[data-iz]');
    if (!b) return;
    RZ.izotop = +b.dataset.iz;
    RZ.bezi = false;
    rozpad();
  });
  $('btnRZStart').addEventListener('click', () => {
    if (!RZ.bezi && RZ.jadra.every(j => !j.zive)) rzReset();   // po dopadu začínáme znovu
    RZ.bezi = !RZ.bezi;
    $('btnRZStart').textContent = RZ.bezi ? '⏸️ Pauza' : '▶️ Spustit čas';
    if ($('rzHotovo')) $('rzHotovo').textContent = '';
    if (RZ.bezi) rzStart();
  });
  $('btnRZReset').addEventListener('click', () => {
    rzReset();
    RZ.bezi = false;
    $('btnRZStart').textContent = '▶️ Spustit čas';
    $('rzHotovo').textContent = '';
    rzKresli(); rzStavovky();
  });
  $('posRychlost').addEventListener('input', e => {
    RZ.rychlost = +e.target.value;
    $('hodRychlost').textContent = fmt(RZ.rychlost) + '×';
  });
  $('rzSave').onclick = rzZapis;
  $('rzStep').onclick = () => {
    RZ.bezi = false; $('btnRZStart').textContent = '▶️ Spustit čas';
    RZ.t += 1;
    for (const j of RZ.jadra) if (j.zive && Math.random() < .5) j.zive = false;
    RZ.mereni.push([RZ.t, RZ.jadra.filter(j => j.zive).length]);
    rzKresli(); rzStavovky(); rzZapis();
    if (RZ.jadra.every(j => !j.zive)) rzKonec();
  };
  $('hodRychlost').textContent = fmt(RZ.rychlost) + '×';
  rzKresli(); rzStavovky();
  rzStart();
}

function rzStart() {
  if (RZ.animace) cancelAnimationFrame(RZ.animace);
  let posledni = null;
  const krok = t => {
    if (!$('plátnoRZ')) { RZ.animace = null; return; }
    if (posledni === null) posledni = t;
    const dt = Math.min(0.05, (t - posledni) / 1000);
    posledni = t;
    if (RZ.bezi && !document.hidden) {
      RZ.t += dt * RZ.rychlost * 0.5;              // 1 poločas ≈ 2 s při rychlosti 1×
      // pravděpodobnost rozpadu za dt odpovídá poločasu 1
      const p = 1 - Math.pow(0.5, dt * RZ.rychlost * 0.5);
      for (const j of RZ.jadra) if (j.zive && Math.random() < p) j.zive = false;
      const zive = RZ.jadra.filter(j => j.zive).length;
      RZ.mereni.push([RZ.t, zive]);
      if (RZ.mereni.length > 400) RZ.mereni.shift();
      // rozpadlo se poslední jádro – čas nemá dál co měřit, jinak by běžel donekonečna
      if (zive === 0) rzKonec();
    }
    rzKresli(); rzStavovky();
    RZ.animace = requestAnimationFrame(krok);
  };
  RZ.animace = requestAnimationFrame(krok);
}

/* Poslední jádro se rozpadlo: zastavíme čas a řekneme, kdy se to stalo. */
function rzKonec() {
  RZ.bezi = false;
  const iz = IZOTOPY[RZ.izotop];
  if ($('btnRZStart')) $('btnRZStart').textContent = '▶️ Spustit čas';
  if ($('rzHotovo')) {
    $('rzHotovo').className = 'verdikt kriticka';
    $('rzHotovo').innerHTML = `✅ Rozpadla se všechna jádra — trvalo to `
      + `<b>${fmt(RZ.t)}</b> poločasů, tedy asi <b>${fmt(RZ.t * iz.t)} ${iz.jednotka}</b>. `
      + `Teoretická křivka nemá konečný čas úplného rozpadu; okamžik posledního rozpadu v malém vzorku je náhodný.`;
  }
}

function rzKresli() {
  const pl = $('plátnoRZ'), gr = $('plátnoRZG');
  if (!pl || !gr) return;
  const s = getComputedStyle(document.documentElement);
  const barva = n => s.getPropertyValue(n).trim();
  const c = pl.getContext('2d');
  c.clearRect(0, 0, RZ_W, RZ_H);
  for (const j of RZ.jadra) {
    c.beginPath();
    c.arc(j.x, j.y, j.zive ? 5 : 2.5, 0, Math.PI * 2);
    c.fillStyle = j.zive ? barva('--accent') : barva('--border');
    c.fill();
  }

  // graf: naměřeno vs. teorie
  const g = gr.getContext('2d');
  const GW = RZ_W, GH = 150, X0 = 34, Y0 = 122, SIR = GW - X0 - 14, VYS = 100;
  g.clearRect(0, 0, GW, GH);
  // osa se roztáhne podle skutečně uplynulého času, jinak by se konec grafu
  // nalepil na pravý okraj a křivka by tam vypadala jako vodorovná čára
  const maxT = Math.max(5, Math.ceil(RZ.t));
  const X = t => X0 + Math.min(t, maxT) / maxT * SIR;
  const Y = n => Y0 - n / RZ_POCET * VYS;

  g.strokeStyle = barva('--border'); g.lineWidth = 1;
  for (let i = 0; i <= maxT; i++) {
    g.beginPath(); g.moveTo(X(i), 12); g.lineTo(X(i), Y0); g.stroke();
    g.fillStyle = barva('--text-faint'); g.font = '10px sans-serif'; g.textAlign = 'center';
    g.fillText(i + 'T', X(i), Y0 + 14);
  }
  g.strokeStyle = barva('--text-muted'); g.lineWidth = 1.5;
  g.beginPath(); g.moveTo(X0, 12); g.lineTo(X0, Y0); g.lineTo(X0 + SIR, Y0); g.stroke();

  g.strokeStyle = barva('--warn'); g.lineWidth = 2; g.setLineDash([5, 4]);
  g.beginPath();
  for (let t = 0; t <= maxT; t += 0.05) {
    const n = RZ_POCET * Math.pow(0.5, t);
    t ? g.lineTo(X(t), Y(n)) : g.moveTo(X(t), Y(n));
  }
  g.stroke(); g.setLineDash([]);

  g.strokeStyle = barva('--accent'); g.lineWidth = 2.4;
  g.beginPath();
  RZ.mereni.forEach(([t, n], i) => { i ? g.lineTo(X(t), Y(n)) : g.moveTo(X(t), Y(n)); });
  g.stroke();

  g.fillStyle = barva('--text-faint'); g.font = '10px sans-serif'; g.textAlign = 'right';
  g.fillText(String(RZ_POCET), X0 - 4, Y(RZ_POCET) + 4);
  g.fillText('0', X0 - 4, Y0 + 4);
}

function rzStavovky() {
  if (!$('rzZbyva')) return;
  const iz = IZOTOPY[RZ.izotop];
  const zive = RZ.jadra.filter(j => j.zive).length;
  $('rzZbyva').textContent = zive + ' z ' + RZ_POCET;
  $('rzPolocasy').textContent = fmt(RZ.t);
  $('rzCas').textContent = fmt(RZ.t * iz.t) + ' ' + iz.jednotka;
  $('rzTeorie').textContent = Math.round(RZ_POCET * Math.pow(0.5, RZ.t)) + ' jader';
}

